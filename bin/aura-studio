# ─────────────────────────────────────────────── helpers ───
def conf_get(key, default=""):
    try:
        out = subprocess.check_output(
            f"grep -E '^{key}=' {CONF_PATH} | cut -d= -f2", shell=True, text=True).strip()
        return out if out else default
    except:
        return default

def conf_set(key, value):
    subprocess.run(
        f"sed -i 's|^{key}=.*|{key}={value}|' {CONF_PATH}", shell=True)

def aura(cmd):
    subprocess.Popen(f"{AURA_BIN} {cmd}", shell=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def mono_lbl(text, color="#444444", size=11, spacing=1):
    """Helper: monospace label."""
    lbl = QLabel(text)
    lbl.setStyleSheet(
        f"color:{color}; font-family:'JetBrains Mono','Fira Mono',monospace;"
        f"font-size:{size}px; letter-spacing:{spacing}px;")
    return lbl

def section_title(text):
    lbl = QLabel(text.upper())
    lbl.setStyleSheet(
        "color:#222222; font-family:'JetBrains Mono','Fira Mono',monospace;"
        "font-size:10px; letter-spacing:3px; font-weight:bold;")
    return lbl

def accent_btn(text, name="ApplyBtn"):
    btn = QPushButton(text)
    btn.setObjectName(name)
    btn.setFocusPolicy(NoFocus)
    btn.setCursor(QCursor(HC))
    return btn

# ─────────────────────────────────────────────── Toggle ───
class ToggleSwitch(QWidget):
    toggled = pyqtSignal(bool)
    def __init__(self, initial=False, parent=None):
        super().__init__(parent)
        self.setFixedSize(44, 24)
        self._on = initial

    def isChecked(self): return self._on
    def setChecked(self, val):
        self._on = val
        self.update()

    def mousePressEvent(self, e):
        self._on = not self._on
        self.update()
        self.toggled.emit(self._on)

    def paintEvent(self, e):
        try:
            from PyQt6.QtGui import QPainter, QPainterPath, QBrush
        except ImportError:
            from PyQt5.QtGui import QPainter, QPainterPath, QBrush
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing if hasattr(QPainter, 'RenderHint') else QPainter.Antialiasing)
        track_color = QColor(ACCENT) if self._on else QColor("#1a1a1a")
        p.setBrush(QBrush(track_color))
        p.setPen(Qt.PenStyle.NoPen if hasattr(Qt, 'PenStyle') else Qt.NoPen)
        p.drawRoundedRect(0, 4, 44, 16, 8, 8)
        knob_x = 22 if self._on else 2
        knob_color = QColor("#0d0d0d") if self._on else QColor("#333333")
        p.setBrush(QBrush(knob_color))
        p.drawEllipse(knob_x, 2, 20, 20)
        p.end()

# ─────────────────────────────────────────────── CARDS ───
class WallpaperCard(QFrame):
    def __init__(self, video_path, parent=None):
        super().__init__(parent)
        self.setObjectName("Card")
        self.video_path = video_path
        self.setFixedSize(240, 220)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 10)
        layout.setSpacing(8)

        jpg_path = video_path.replace(".mp4", ".jpg")
        self.thumb = QLabel()
        self.thumb.setFixedSize(224, 126)
        self.thumb.setStyleSheet("border-radius: 4px; background-color: #111111;")
        if os.path.exists(jpg_path):
            self.thumb.setStyleSheet(
                f"border-image: url('{jpg_path}') 0 0 0 0 stretch stretch; border-radius: 4px;")
        layout.addWidget(self.thumb)

        filename = os.path.basename(video_path)
        title = filename.replace(".mp4", "").replace("-", " ").replace(".", " ").title()
        if len(title) > 24: title = title[:21] + "…"
        try: size_mb = os.path.getsize(video_path) / (1024*1024)
        except: size_mb = 0.0

        info = QHBoxLayout()
        t = QLabel(title)
        t.setStyleSheet(
            "color:#cccccc; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:11px; font-weight:bold;")
        s = QLabel(f"{size_mb:.1f}mb")
        s.setStyleSheet(
            "color:#333333; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        
        self.fav_btn = QPushButton("❤" if self.video_path in load_favs() else "♡")
        self.fav_btn.setFixedSize(20, 20)
        self.fav_btn.setFocusPolicy(NoFocus)
        self.fav_btn.setCursor(QCursor(HC))
        self.fav_btn.setStyleSheet("""
            QPushButton { background: transparent; color: #555555; border: none; font-size: 13px; }
            QPushButton:hover { color: #ff4444; }
        """ if self.video_path not in load_favs() else """
            QPushButton { background: transparent; color: #ff4444; border: none; font-size: 13px; }
            QPushButton:hover { color: #ff6666; }
        """)
        self.fav_btn.clicked.connect(self.on_favorite)

        info.addWidget(t)
        info.addStretch()
        info.addWidget(self.fav_btn)
        info.addWidget(s)
        layout.addLayout(info)

        btns = QHBoxLayout()
        btns.setSpacing(6)
        apply_btn = accent_btn("▶ APPLY")
        apply_btn.clicked.connect(self.on_apply)

        trash_btn = QPushButton("✕")
        trash_btn.setObjectName("TrashBtn")
        trash_btn.setFixedSize(28, 28)
        trash_btn.setFocusPolicy(NoFocus)
        trash_btn.setCursor(QCursor(HC))
        trash_btn.clicked.connect(self.on_delete)

        btns.addWidget(apply_btn)
        btns.addWidget(trash_btn)
        layout.addLayout(btns)

    def on_apply(self):
        main_win = self.window()
        target = main_win.target_mon_cb.currentData() if hasattr(main_win, "target_mon_cb") else ""
        args = [AURA_BIN, "apply", self.video_path]
        if target: args.append(target)
        subprocess.Popen(args)
        main_win = self.window()
        if hasattr(main_win, "active_lbl"):
            t = os.path.basename(self.video_path).replace(".mp4","").replace("-"," ")
            main_win.active_lbl.setText(f"▶  {t[:28].upper()}")
        # Immediately extract color from the local JPG thumbnail using our own
        # bright/saturated algorithm — independent of aura's broken dominant-color.
        jpg = self.video_path.replace(".mp4", ".jpg")
        if os.path.exists(jpg) and hasattr(main_win, "_run_colorthief"):
            threading.Thread(
                target=main_win._run_colorthief, args=(jpg,), daemon=True).start()

    def on_favorite(self):
        favs = load_favs()
        if self.video_path in favs:
            favs.remove(self.video_path)
        else:
            favs.append(self.video_path)
        save_favs(favs)
        # Tell main window to reload (using window() since Card is deeply nested)
        main_win = self.window()
        if hasattr(main_win, "load_wallpapers"):
            main_win.load_wallpapers()

    def on_delete(self):
        jpg = self.video_path.replace(".mp4", ".jpg")
        try:
            os.remove(self.video_path)
            if os.path.exists(jpg): os.remove(jpg)
            self.setParent(None)
            self.deleteLater()
        except Exception as ex:
            print(f"Error borrando: {ex}")

# ─────────────────────────────────────────────── PANELS ───
class LibraryPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 16, 16)
        layout.setSpacing(16)

        header = QHBoxLayout()
        header.addWidget(section_title("library"))
        header.addStretch()
        
        # Folder buttons
        open_btn = QPushButton("📂")
        open_btn.setFixedSize(32, 32)
        open_btn.setToolTip("Open Downloads Folder")
        open_btn.setStyleSheet("background:transparent; font-size:16px;")
        open_btn.setCursor(QCursor(HC))
        def _open_folder():
            import subprocess
            d = subprocess.check_output([AURA_BIN, "pool-dirs"]).decode().split('\n')[0].strip()
            subprocess.Popen(["xdg-open", d])
        open_btn.clicked.connect(_open_folder)
        header.addWidget(open_btn)
        
        add_btn = QPushButton("➕")
        add_btn.setFixedSize(32, 32)
        add_btn.setToolTip("Add Custom Folder")
        add_btn.setStyleSheet("background:transparent; font-size:14px;")
        add_btn.setCursor(QCursor(HC))
        def _add_folder():
            from PyQt6.QtWidgets import QFileDialog
            d = QFileDialog.getExistingDirectory(self, "Select Folder to Add to Library")
            if d:
                conf = os.path.expanduser("~/.config/aura/aura.conf")
                with open(conf, "r") as f: txt = f.read()
                import re
                txt = re.sub(r'(POOL=\(\n)', r'\1    "' + d + '"\n', txt, count=1)
                with open(conf, "w") as f: f.write(txt)
                self.window().start_download("") # Dummy to refresh if needed, but load_wallpapers is better
                if hasattr(self, "load_wallpapers"): self.load_wallpapers()
        add_btn.clicked.connect(_add_folder)
        header.addWidget(add_btn)
        
        header.addSpacing(8)
        
        self.search_bar = QLineEdit()
        self.search_bar.setPlaceholderText("search wallpapers…")
        self.search_bar.setFixedWidth(200)
        self.search_bar.setFixedHeight(32)
        self.search_bar.textChanged.connect(self.filter_cards)
        header.addWidget(self.search_bar)
        header.addSpacing(12)
        for t in ["ALL", "LIVE", "STATIC"]:
            btn = QPushButton(t)
            btn.setObjectName("TabBtn")
            btn.setFocusPolicy(NoFocus)
            btn.setCheckable(True)
            if t == "ALL": btn.setChecked(True)
            header.addWidget(btn)
        layout.addLayout(header)

        # Separator
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)

        # Grid
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setVerticalScrollBarPolicy(SBOff)
        self.scroll.setHorizontalScrollBarPolicy(SBOff)
        self.grid_w = QWidget()
        self.grid_w.setStyleSheet("background: transparent;")
        self.grid_lay = QGridLayout(self.grid_w)
        self.grid_lay.setSpacing(16)
        self.grid_lay.setAlignment(AF.AlignTop | AF.AlignLeft)
        self.all_cards = []
        self.load_wallpapers()
        self.scroll.setWidget(self.grid_w)
        layout.addWidget(self.scroll)

    def load_wallpapers(self):
        try:
            raw = subprocess.check_output(
                f"{AURA_BIN} pool", shell=True, text=True, stderr=subprocess.DEVNULL)
            files = [line.strip() for line in raw.splitlines()
                     if line.strip().startswith("/") and line.strip().lower().endswith((".mp4", ".webm", ".mkv"))]
        except Exception:
            if not os.path.exists(WALL_DIR):
                return
            files = sorted(
                os.path.join(WALL_DIR, f) for f in os.listdir(WALL_DIR)
                if f.lower().endswith((".mp4", ".webm", ".mkv")))

        # Sort: favorites first, then alphabetical
        favs = set(load_favs())
        files.sort(key=lambda x: (0 if x in favs else 1, os.path.basename(x).lower()))

        for idx, path in enumerate(files):
            jpg = path.replace(".mp4", ".jpg")
            if not os.path.exists(jpg):
                subprocess.Popen(
                    ["ffmpeg", "-y", "-i", path, "-vframes", "1", "-q:v", "2",
                     jpg, "-loglevel", "error"])
            card = WallpaperCard(path)
            self.all_cards.append(card)
            self.grid_lay.addWidget(card, idx // 4, idx % 4)

    def filter_cards(self, text):
        for card in self.all_cards:
            name = os.path.basename(card.video_path).lower()
            card.setVisible(text.lower() in name)


class OnlineCard(QFrame):
    _sem = threading.Semaphore(6)
    _thumb_bytes = pyqtSignal(bytes)

    def __init__(self, title, thumb_url, dl_url, parent=None):
        super().__init__(parent)
        self.setObjectName("Card")
        self.dl_url = dl_url
        self.setFixedSize(224, 200)
        self._thumb_bytes.connect(self._render_thumb)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(8, 8, 8, 10)
        lay.setSpacing(8)

        self.thumb = QLabel("…")
        self.thumb.setFixedSize(208, 117)
        self.thumb.setAlignment(AF.AlignCenter)
        self.thumb.setStyleSheet(
            "background:#111111; border-radius:4px; color:#222222; font-size:18px;")
        lay.addWidget(self.thumb)

        name = title[:22] + "…" if len(title) > 22 else title
        t = QLabel(name.upper())
        t.setStyleSheet(
            "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:10px; font-weight:bold; letter-spacing:1px;")
        t.setWordWrap(True)
        lay.addWidget(t)
        lay.addStretch()

        dl = accent_btn("⬇ DOWNLOAD")
        dl.clicked.connect(self.do_download)
        lay.addWidget(dl)

        threading.Thread(target=self._fetch_bytes, args=(thumb_url,), daemon=True).start()

    def _fetch_bytes(self, url):
        import urllib.request
        with OnlineCard._sem:
            try:
                req  = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"})
                data = urllib.request.urlopen(req, timeout=8).read()
                self._thumb_bytes.emit(data)
            except Exception:
                pass

    def _render_thumb(self, data: bytes):
        try:
            from PyQt6.QtGui import QPixmap
        except ImportError:
            from PyQt5.QtGui import QPixmap
        px = QPixmap()
        px.loadFromData(data)
        if not px.isNull():
            px = px.scaled(
                208, 117,
                Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                Qt.TransformationMode.SmoothTransformation)
            self.thumb.setPixmap(px)
            self.thumb.setStyleSheet("border-radius:4px; background:#111111;")
            self.thumb.setText("")

    def do_download(self):
        main_win = self.window()
        if hasattr(main_win, "start_download"):
            main_win.start_download(self.dl_url)


class ExplorePanel(QWidget):
    catalog_ready = pyqtSignal(list)
    catalog_error = pyqtSignal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._all_items = []
