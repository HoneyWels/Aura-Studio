        header.addWidget(self.provider_cb)
        header.addWidget(self.res_cb)

        self.url_input = QLineEdit()
        self.url_input.setPlaceholderText("Search or paste URL…")
        self.url_input.setFixedHeight(32)
        self.url_input.setFixedWidth(200)
        self.url_input.returnPressed.connect(lambda: self.load_category(self.url_input.text().strip()))
        header.addWidget(self.url_input)
        
        fb = accent_btn("🔍 SEARCH")
        fb.setFixedHeight(32)
        fb.clicked.connect(lambda: self.load_category(self.url_input.text().strip()))
        header.addWidget(fb)
        lay.addLayout(header)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        lay.addWidget(sep)

        # Category row
        cats_row = QHBoxLayout()
        cats_row.setSpacing(4)
        self.cat_btns = []
        cats = [
            ("ALL",       ""),
            ("4K",        "4k"),
            ("ANIME",     "tag:anime"),
            ("GAMES",     "tag:games"),
            ("NATURE",    "tag:nature"),
            ("SUPERHERO", "tag:superhero"),
        ]
        for label, tag in cats:
            b = QPushButton(label)
            b.setObjectName("TabBtn")
            b.setFocusPolicy(NoFocus)
            b.setCheckable(True)
            b.setCursor(QCursor(HC))
            if tag == "": b.setChecked(True)
            b.clicked.connect(lambda _, t=tag: self.load_category(t))
            self.cat_btns.append(b)
            cats_row.addWidget(b)
        cats_row.addStretch()
        lay.addLayout(cats_row)

        # Grid
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.grid_w = QWidget()
        self.grid_w.setStyleSheet("background:transparent;")
        self.grid_lay = QGridLayout(self.grid_w)
        self.grid_lay.setSpacing(12)
        self.grid_lay.setAlignment(AF.AlignTop | AF.AlignLeft)
        self.scroll.setWidget(self.grid_w)
        lay.addWidget(self.scroll)

        # Footer
        bot = QHBoxLayout()
        self.status_lbl = QLabel("CONNECTING TO MOTIONBGS…")
        self.status_lbl.setStyleSheet(
            "color:#222222; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px; letter-spacing:2px;")
        bot.addWidget(self.status_lbl)
        bot.addStretch()
        self.more_btn = accent_btn("+ LOAD MORE")
        self.more_btn.setVisible(False)
        self.more_btn.clicked.connect(self.show_next_batch)
        bot.addWidget(self.more_btn)
        lay.addLayout(bot)

        self.catalog_ready.connect(self._on_catalog_ready)
        self.catalog_error.connect(self._on_error)
        self.load_category("")

    def load_category(self, tag):
        if tag.startswith("http"):
            self.window().start_download(tag)
            return

        if tag.startswith("tag:") or tag == "":
            self.url_input.clear()

        for btn in self.cat_btns:
            btn.setChecked(btn.text().lower() == (tag.replace("tag:", "") or "all"))
        self._all_items = []
        self._shown     = 0
        self.more_btn.setVisible(False)
        for i in reversed(range(self.grid_lay.count())):
            w = self.grid_lay.itemAt(i).widget()
            if w: w.setParent(None)
        if self._loading: return
        self._loading = True
        self.status_lbl.setText("⏳  LOADING CATALOG…")
        
        provider = self.provider_cb.currentText()
        res_idx = self.res_cb.currentIndex()
        threading.Thread(target=self._scrape, args=(provider, tag, res_idx), daemon=True).start()

    def show_next_batch(self):
        batch = self._all_items[self._shown : self._shown + self._batch]
        for i, (_, title, thumb_url, dl_url) in enumerate(batch):
            card = OnlineCard(title, thumb_url, dl_url)
            idx  = self._shown + i
            self.grid_lay.addWidget(card, idx // 4, idx % 4)
        self._shown += len(batch)
        self.status_lbl.setText(
            f"✓  {self._shown} / {len(self._all_items)} LOADED")
        self.more_btn.setVisible(self._shown < len(self._all_items))

    def _scrape(self, provider, tag, res_idx=0):
        import urllib.request, re, urllib.parse
        try:
            items = []
            seen = set()
            headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}
            
            res_str = ""
            if res_idx == 1: res_str = "1080p"
            elif res_idx == 2: res_str = "1440p"
            elif res_idx == 3: res_str = "4k"
            
            if provider == "MotionBgs":
                base = "https://motionbgs.com"
                query = tag.replace("tag:", "") if tag else ""
                if res_str: query = f"{query} {res_str}".strip()
                
                if query:
                    path = f"/search?q={urllib.parse.quote(query)}"
                else:
                    path = "/"
                    
                req  = urllib.request.Request(base + path, headers=headers)
                html = urllib.request.urlopen(req, timeout=12).read().decode("utf-8", errors="replace")
                matches = re.findall(r'media/(\d+)/([^>"\']+?)\.jpg', html)
                
                for mid, raw_name in matches:
                    if mid not in seen:
                        seen.add(mid)
                        clean = re.sub(r'\.\d+x\d+$', '', raw_name)
                        title = clean.replace("-", " ").replace(".", " ").title()
                        items.append((
                            mid, title,
                            f"{base}/i/c/364x205/media/{mid}/{raw_name}.jpg",
                            f"{base}/dl/hd/{mid}/",
                        ))
                        
            elif provider == "MoeWalls":
                base = "https://moewalls.com"
                query = tag.replace("tag:", "") if tag else ""
                if res_str: query = f"{query} {res_str}".strip()
                
                if not query:
                    base_path = "/"
                else:
                    base_path = f"/?s={urllib.parse.quote(query)}"
                
                for p in range(1, 5):
                    if p == 1:
                        path = base_path
                    else:
                        if base_path.startswith("/?"):
                            path = f"/page/{p}{base_path}"
                        else:
                            path = f"/page/{p}/"
                    
                    try:
                        req  = urllib.request.Request(base + path, headers=headers)
                        html = urllib.request.urlopen(req, timeout=8).read().decode("utf-8", errors="replace")
                        matches = re.findall(r'<a title="([^"]+)".*?<img[^>]+src="([^"]+wp-content/uploads/([0-9]{4})/[^"]+-thumb[^"]*\.jpg)"', html)
                        
                        if not matches:
                            break
                            
                        for title, thumb_url, year in matches:
                            if thumb_url not in seen:
                                seen.add(thumb_url)
                                clean_title = title.replace("Live Wallpaper", "").replace("-", "").strip()
                                slug_match = re.search(r'/([^/]+)-thumb', thumb_url)
                                if slug_match:
                                    slug = slug_match.group(1)
                                    dl_url = f"{base}/wp-content/uploads/preview/{year}/{slug}-preview.webm"
                                    items.append((slug, clean_title, thumb_url, dl_url))
                    except Exception:
                        break

            elif provider.startswith("Wallhaven"):
                base = "https://wallhaven.cc/api/v1/search"
                import json
                
                res_idx = self.res_cb.currentIndex()
                res_map = {0: "", 1: "1920x1080", 2: "2560x1440", 3: "3840x2160"}
                res = res_map.get(res_idx, "")
                
                query = tag.replace("tag:", "")
                params = [("q", query)]
                if res:
                    params.append(("resolutions", res))
                params.append(("sorting", "random"))
                
                for p in range(1, 3):
                    url = base + "?" + urllib.parse.urlencode(params + [("page", str(p))])
                    req = urllib.request.Request(url, headers=headers)
                    try:
                        resp = urllib.request.urlopen(req, timeout=10).read().decode("utf-8")
                        data = json.loads(resp)
                        for d in data.get("data", []):
                            thumb = d.get("thumbs", {}).get("small", "")
                            dl = d.get("path", "")
                            res_str = d.get("resolution", "")
                            if dl not in seen:
                                seen.add(dl)
                                items.append((d.get("id", ""), res_str, thumb, dl))
                    except Exception:
                        break

            self.catalog_ready.emit(items)
        except Exception as ex:
            self.catalog_error.emit(str(ex))

    def _on_catalog_ready(self, items):
        self._loading   = False
        self._all_items = items
        self._shown     = 0
        self.show_next_batch()

    def _on_error(self, msg):
        self._loading = False
        self.status_lbl.setText(f"✗  {msg[:60]}")
        self.status_lbl.setStyleSheet(
            "color:#f38ba8; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")


class DisplaysPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(24)

        layout.addWidget(section_title("displays"))
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)

        monitors = self._get_monitors()
        for mon in monitors:
            layout.addWidget(self._make_monitor_card(mon))
        layout.addStretch()

    def _get_monitors(self):
        out = subprocess.check_output("xrandr --query", shell=True, text=True)
        monitors = []
        for line in out.split('\n'):
            m = re.match(r'^(\S+) connected.*?(\d+x\d+)\+', line)
            if m:
                monitors.append({"name": m.group(1), "res": m.group(2)})
        return monitors

    def _make_monitor_card(self, mon):
        card = QFrame()
        card.setObjectName("MonitorCard")
        card.setFixedHeight(160)
        lay = QVBoxLayout(card)
        lay.setContentsMargins(20, 16, 20, 16)
        lay.setSpacing(12)

        header = QHBoxLayout()
        name_lbl = QLabel(mon['name'].upper())
        name_lbl.setStyleSheet(
            "color:#cccccc; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:13px; font-weight:bold; letter-spacing:2px;")
        res_lbl = QLabel(mon['res'])
        res_lbl.setStyleSheet(
            "color:#333333; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:11px;")
        header.addWidget(name_lbl)
        header.addStretch()
        header.addWidget(res_lbl)
        lay.addLayout(header)

        scale_row = QHBoxLayout()
        scale_row.setSpacing(6)
        group = QButtonGroup(card)
        safe_mon = mon['name'].replace('-', '_')
        current_mode = conf_get(f"SCALE_{safe_mon}", "FILL").upper()

        for mode in ["FIT", "FILL", "STRETCH", "CENTER"]:
            btn = QPushButton(mode)
            btn.setObjectName("ScaleBtn")
            btn.setFocusPolicy(NoFocus)
            btn.setCheckable(True)
            btn.setCursor(QCursor(HC))
            if mode == current_mode:
                btn.setChecked(True)
            group.addButton(btn)
            btn.clicked.connect(lambda _, m=mode, n=mon['name']: self.set_scale(n, m))
            scale_row.addWidget(btn)
        scale_row.addStretch()
        lay.addLayout(scale_row)
        return card

    def set_scale(self, monitor, mode):
        safe_mon = monitor.replace("-", "_")
        conf_set(f"SCALE_{safe_mon}", mode.upper())
        threading.Thread(
            target=lambda: subprocess.run(f"pkill -f 'aura-wallpaper-{monitor}'", shell=True),
            daemon=True).start()


class SettingsPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        
