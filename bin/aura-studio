def build_theme_stylesheet(name, dynamic_acc=None, dyn_bg=None, dyn_sb=None, dyn_ctrl=None):
    t = APP_THEMES.get(name, APP_THEMES["Vellum (Default)"])
    acc = dynamic_acc if dynamic_acc else t["accent"]
    dim = t["accent_dim"] if not dynamic_acc else "#111111"
    bg = dyn_bg if dyn_bg else t["bg"]
    sb = dyn_sb if dyn_sb else t["sidebar"]
    ctrl = dyn_ctrl if dyn_ctrl else "rgba(0,0,0,0.75)"
    card = t["card_bg"]
    txt = t["on_surface"]
    sv = t["surface_variant"]
    
    return f"""
QMainWindow {{ background: transparent; }}
QScrollArea {{ background: transparent; border: none; }}
QScrollArea > QWidget > QWidget {{ background: transparent; }}
#MainContainer {{ background-color: {bg}; }}
#Sidebar {{ background-color: {sb}; border-right: 1px solid rgba(255,255,255,10); }}
#TopBar {{ background-color: rgba(0,0,0,0.35); border-bottom: 1px solid rgba(255,255,255,5); }}
#FloatingDock {{ background-color: {ctrl}; border: 1px solid rgba(255,255,255,22); border-radius: 26px; }}
QPushButton[objectName="PlayBtn"] {{ color: {txt}; font-size: 16px; border-radius: 16px; background: transparent; border: none; }}
QPushButton[objectName="PlayBtn"]:hover {{ background: rgba(255,255,255,20); }}
QLineEdit#SearchBar {{ background: rgba(255,255,255,8); color: {txt}; border: none; border-radius: 16px; padding: 6px 16px; font-size: 13px; }}
QLineEdit#SearchBar:focus {{ background: rgba(255,255,255,14); }}
#Logo {{ color: {txt}; font-size: 20px; font-weight: bold; }}
#LogoSub {{ color: {acc}; font-family: 'JetBrains Mono',monospace; font-size: 11px; letter-spacing: 2px; }}
QPushButton[objectName="NavBtn"] {{ background: transparent; color: {sv}; font-size: 14px; text-align: left; padding: 10px 16px; border: none; border-radius: 8px; margin: 2px 16px; }}
QPushButton[objectName="NavBtn"]:hover {{ background: rgba(255,255,255,8); color: {txt}; }}
QPushButton[objectName="NavBtn"]:checked {{ background: transparent; color: {acc}; border-left: 2px solid {acc}; font-weight: bold; }}
QPushButton[objectName="TagPill"] {{ background: rgba(255,255,255,8); color: {txt}; border-radius: 12px; padding: 4px 12px; font-size: 11px; border: none; }}
QPushButton[objectName="TagPill"]:hover {{ background: rgba(255,255,255,14); }}
QPushButton[objectName="TagPill"]:checked {{ background: {acc}; color: {dim}; font-weight: bold; }}
QScrollBar:vertical {{ background: transparent; width: 6px; }} QScrollBar::handle:vertical {{ background: rgba(255,255,255,18); border-radius: 3px; min-height: 20px; }} QScrollBar::handle:vertical:hover {{ background: {acc}; }} QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0px; }} QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {{ background: none; }}
QPushButton[objectName="ApplyBtn"] {{
    background-color: transparent; color: {acc};
    border: 1px solid {acc};
    border-radius: 4px;
    font-family: 'JetBrains Mono', 'Fira Mono', monospace;
    font-size: 11px; font-weight: bold; padding: 5px 12px; letter-spacing: 1px;
}}
QPushButton[objectName="ApplyBtn"]:hover {{ background-color: {acc}; color: #0d0d0d; }}
#Card {{ background: {card}; border-radius: 12px; border: 1px solid transparent; }}
#Card:hover {{ border: 1px solid {acc}aa; }}
#CardTitle {{ color: {txt}; font-size: 15px; font-weight: bold; }}
QLabel {{ color: {txt}; font-family: 'Inter', sans-serif; }}
"""

FAVS_FILE = os.path.expanduser("~/.config/aura/favorites.json")
def load_favs():
    try:
        if os.path.exists(FAVS_FILE):
            with open(FAVS_FILE) as f: return json.load(f)
    except: pass
    return []

def save_favs(favs):
    os.makedirs(os.path.dirname(FAVS_FILE), exist_ok=True)
    with open(FAVS_FILE, "w") as f: json.dump(favs, f)

