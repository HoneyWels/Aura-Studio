#!/usr/bin/env python3
import sys, os, subprocess, threading, re, traceback, shutil, json

AURA_RUNTIME = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
    f"aura-{os.getuid()}"
)
ACCENT_ENV = os.path.join(AURA_RUNTIME, "accent.env")

def _excepthook(exc_type, exc_value, exc_tb):
    msg = "".join(traceback.format_exception(exc_type, exc_value, exc_tb))
    print(f"[aura-studio CRASH]\n{msg}", file=sys.stderr)
sys.excepthook = _excepthook

try:
    from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
                                 QPushButton, QLabel, QScrollArea, QLineEdit, QGridLayout,
                                 QFrame, QStackedWidget, QSizePolicy, QCheckBox, QButtonGroup,
                                 QTextEdit, QSpacerItem, QSlider, QComboBox)
    from PyQt6.QtCore import Qt, QPoint, QSize, pyqtSignal, QTimer, QtMsgType
    from PyQt6.QtGui import QCursor, QColor, QFont
    import PyQt6.QtCore as _qcore

    def _qt_msg_handler(msg_type, context, msg):
        level = {QtMsgType.QtDebugMsg: "DBG", QtMsgType.QtWarningMsg: "WARN",
                 QtMsgType.QtCriticalMsg: "CRIT", QtMsgType.QtFatalMsg: "FATAL"}.get(msg_type, "?")
        if msg_type in (QtMsgType.QtCriticalMsg, QtMsgType.QtFatalMsg):
            print(f"[Qt/{level}] {msg}", file=sys.stderr)
    _qcore.qInstallMessageHandler(_qt_msg_handler)

    AF   = Qt.AlignmentFlag
    LB   = Qt.MouseButton.LeftButton
    SBOff= Qt.ScrollBarPolicy.ScrollBarAlwaysOff
    HC   = Qt.CursorShape.PointingHandCursor
    NoFocus = Qt.FocusPolicy.NoFocus
except ImportError:
    from PyQt5.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
                                 QPushButton, QLabel, QScrollArea, QLineEdit, QGridLayout,
                                 QFrame, QStackedWidget, QSizePolicy, QCheckBox, QButtonGroup,
                                 QTextEdit, QSpacerItem, QSlider, QComboBox)
    from PyQt5.QtCore import Qt, QPoint, QSize, pyqtSignal, QTimer
    from PyQt5.QtGui import QCursor, QColor, QFont
    AF   = Qt
    LB   = Qt.LeftButton
    SBOff= Qt.ScrollBarAlwaysOff
    HC   = Qt.PointingHandCursor
    NoFocus = Qt.NoFocus

WALL_DIR  = os.path.expanduser("~/.config/bspwm/rices/wels/walls")
CONF_PATH = os.path.expanduser("~/.config/aura/aura.conf")
AURA_BIN  = os.path.expanduser("~/.local/bin/aura")

# ─── Accent color base (purple, updated dynamically) ───
ACCENT    = "#cba6f7"

FAVS_FILE = os.path.expanduser("~/.config/aura/favorites.json")
def load_favs():
    try:
        if os.path.exists(FAVS_FILE):
            with open(FAVS_FILE) as f: return json.load(f)
    except: pass
    return []

def save_favs(favs):
    os.makedirs(os.path.dirname(FAVS_FILE), exist_ok=True)
    with open(FAVS_FILE, "w") as f: json.dump(favs, f)

