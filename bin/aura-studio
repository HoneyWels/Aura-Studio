class ThumbWorkerSignals(_qcore.QObject if hasattr(sys.modules[__name__], '_qcore') else QObject):
    result = pyqtSignal(str, object)

class ThumbWorker(QRunnable):
    def __init__(self, path, signals):
        super().__init__()
        self.path = path
        self.signals = signals

    def run(self):
        try:
            try:
                from PyQt6.QtGui import QImageReader
                from PyQt6.QtCore import QSize
            except:
                from PyQt5.QtGui import QImageReader
                from PyQt5.QtCore import QSize
            reader = QImageReader(self.path)
            reader.setScaledSize(QSize(268, 151))
            img = reader.read()
            if not img.isNull():
                self.signals.result.emit(self.path, img)
        except:
            pass

class AuraStudio(QMainWindow):
    theme_ready = pyqtSignal(int, int, int)

    def __init__(self):
        super().__init__()
        # CRITICAL: FramelessWindowHint + WA_TranslucentBackground only.
        # NEVER use BypassWindowManagerHint — must be managed by bspwm tiling.
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint if hasattr(Qt, 'WindowType') else Qt.FramelessWindowHint)
        self.setAttribute(
            Qt.WidgetAttribute.WA_TranslucentBackground if hasattr(Qt, 'WidgetAttribute') else Qt.WA_TranslucentBackground)
        self.resize(1120, 720)
        self._center()
        self.theme_ready.connect(self.apply_dynamic_theme)
        self._is_dragging = False
        self._drag_pos = QPoint()
        self._build_ui()
        saved_theme = conf_get('APP_THEME', 'Vellum (Default)')
        self.setStyleSheet(build_theme_stylesheet(saved_theme))
        
        # System Tray setup
        from PyQt6.QtWidgets import QSystemTrayIcon, QMenu
        from PyQt6.QtGui import QIcon, QPixmap, QPainter, QColor
        self.tray_icon = QSystemTrayIcon(self)
        
        pixmap = QPixmap(32, 32)
        pixmap.fill(Qt.GlobalColor.transparent if hasattr(Qt.GlobalColor, 'transparent') else Qt.transparent)
        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing if hasattr(QPainter.RenderHint, 'Antialiasing') else QPainter.Antialiasing)
        painter.setBrush(QColor("#cba6f7"))
        painter.setPen(Qt.PenStyle.NoPen if hasattr(Qt.PenStyle, 'NoPen') else Qt.NoPen)
        painter.drawEllipse(4, 4, 24, 24)
        painter.end()
        self.tray_icon.setIcon(QIcon(pixmap))
        
        tray_menu = QMenu()
        tray_menu.setStyleSheet("QMenu { background-color: #1a1a1a; color: #cccccc; border: 1px solid #333333; } QMenu::item:selected { background-color: #333333; }")
        
        show_act = tray_menu.addAction("Show Aura Studio")
        show_act.triggered.connect(self.showNormal)
        show_act.triggered.connect(self.raise_)
        show_act.triggered.connect(self.activateWindow)
        
        tray_menu.addSeparator()
        
        pause_act = tray_menu.addAction("Play / Pause")
        pause_act.triggered.connect(lambda: aura("toggle-pause"))
        
        next_act = tray_menu.addAction("Next WelsPaper")
        next_act.triggered.connect(lambda: aura("next"))
        
        tray_menu.addSeparator()
        quit_act = tray_menu.addAction("Quit Aura Studio")
        quit_act.triggered.connect(QApplication.instance().quit)
        
        self.tray_icon.setContextMenu(tray_menu)
        self.tray_icon.show()
        
        # Watch the wallpaper thumbnail that aura updates on every change.
        # We use our own ColorThief (bright/saturated) instead of aura's
        # broken dominant-color algorithm that always returns purple.
        self._thumb_path  = os.path.expanduser("~/.cache/aura-current.webp")
        self._thumb_mtime = 0
        self._watcher = QTimer(self)
        self._watcher.timeout.connect(self._check_thumb)
        self._watcher.start(1500)
        # Load initial color from current thumbnail (if it exists)
        QTimer.singleShot(200, self._load_from_thumb)
        
        # Enable Drag & Drop
        self.setAcceptDrops(True)

    def _build_ui(self):
        root = QFrame()
        root.setObjectName("MainContainer")
        self.setCentralWidget(root)
        root_lay = QHBoxLayout(root)
        root_lay.setContentsMargins(0, 0, 0, 0)
        root_lay.setSpacing(0)

        # ── Sidebar ──
        sidebar = QFrame()
        sidebar.setObjectName("Sidebar")
        sidebar.setFixedWidth(240)
        sb_lay = QVBoxLayout(sidebar)
        sb_lay.setContentsMargins(0, 0, 0, 0)
        sb_lay.setSpacing(8)

        # Logo block
        logo_frame = QFrame()
        logo_frame.setFixedHeight(80)
        lf_lay = QHBoxLayout(logo_frame)
        lf_lay.setContentsMargins(20, 20, 20, 10)
        lf_lay.setSpacing(8)
        
        logo_text = QVBoxLayout()
        logo_lbl = QLabel("VELLUM")
        logo_lbl.setObjectName("Logo")
        sub_lbl = QLabel("WAYLAND::CORE")
        sub_lbl.setObjectName("LogoSub")
        logo_text.addWidget(logo_lbl)
        logo_text.addWidget(sub_lbl)
        logo_text.setSpacing(0)
        lf_lay.addLayout(logo_text)
        sb_lay.addWidget(logo_frame)

        # Nav
        self.nav_btns = []
        nav_items = [
            ("󰕰  Library",  0),
            ("󰀪  Explore",  1),
            ("󰍹  Displays", 2),
            ("󰒓  Settings", 3),
            ("󰋽  About",    4),
        ]
        for label, idx in nav_items:
            btn = QPushButton(label)
            btn.setObjectName("NavBtn")
            btn.setFocusPolicy(NoFocus)
            btn.setCheckable(True)
            btn.setCursor(QCursor(HC))
            btn.clicked.connect(lambda _, i=idx: self.switch_view(i))
            self.nav_btns.append(btn)
            sb_lay.addWidget(btn)

        self.nav_btns[0].setChecked(True)
        sb_lay.addStretch()
        
        # Telemetry Block
        tele_frame = QFrame()
        tele_frame.setStyleSheet("background-color: rgba(31, 31, 37, 0.6); border-radius: 8px; margin: 16px;")
        tele_lay = QVBoxLayout(tele_frame)
        tele_lay.setContentsMargins(12, 12, 12, 12)
        tele_lbl = QLabel("TELEMETRY • LIVE")
        tele_lbl.setStyleSheet("color: #e7bcbd; font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: bold;")
        tele_lay.addWidget(tele_lbl)
        
        gpu_lbl = QLabel("GPU LOAD: 34% // 60FPS")
        gpu_lbl.setStyleSheet("color: #e4e1e9; font-size: 11px;")
        tele_lay.addWidget(gpu_lbl)
        
        sb_lay.addWidget(tele_frame)
        root_lay.addWidget(sidebar)

        # ── Right Area ──
        right_widget = QFrame()
        right_lay = QVBoxLayout(right_widget)
        right_lay.setContentsMargins(0, 0, 0, 0)
        right_lay.setSpacing(0)
        
        # TopBar
        topbar = QFrame()
        topbar.setObjectName("TopBar")
        topbar.setFixedHeight(64)
        topbar_lay = QHBoxLayout(topbar)
        topbar_lay.setContentsMargins(24, 0, 24, 0)
        
        title_lbl = QLabel("Vellum // Engine v2.4")
        title_lbl.setStyleSheet("color: #e7bcbd; font-family: 'JetBrains Mono', monospace; font-size: 12px;")
        topbar_lay.addWidget(title_lbl)
        topbar_lay.addSpacing(24)
        
        self.top_search_bar = QLineEdit()
        self.top_search_bar.setObjectName("SearchBar")
        self.top_search_bar.setPlaceholderText("Search WelsPapers or URLs...")
        self.top_search_bar.setFixedWidth(300)
        
        def _on_search_changed(txt):
            if self.stack.currentIndex() == 0:
                self.stack.widget(0).filter_cards(txt)
                
        def _on_search_enter():
            idx = self.stack.currentIndex()
            txt = self.top_search_bar.text().strip()
            if idx == 1:
                self.stack.widget(1).load_category(txt)
            elif idx == 0:
                self.stack.widget(0).filter_cards(txt)

        self.top_search_bar.textChanged.connect(_on_search_changed)
        self.top_search_bar.returnPressed.connect(_on_search_enter)
        topbar_lay.addWidget(self.top_search_bar)
        topbar_lay.addStretch()
        
        from PyQt6.QtWidgets import QButtonGroup
        self.type_group = QButtonGroup(self)
        self.type_group.setExclusive(True)
        
        for i, pill in enumerate(["ALL", "LIVE", "STATIC"]):
            p = QPushButton(pill)
            p.setObjectName("TagPill")
            p.setCheckable(True)
            p.setCursor(QCursor(HC))
            if i == 0: p.setChecked(True)
            self.type_group.addButton(p, i)
            topbar_lay.addWidget(p)
            
        def _on_type_changed(btn):
            # 0=ALL, 1=LIVE, 2=STATIC
            idx = self.type_group.id(btn)
            self.switch_view(0) # Switch to Library tab!
            lib = self.stack.widget(0)
            if hasattr(lib, "_filter_type"):
                lib._filter_type(idx)
                
        self.type_group.buttonClicked.connect(_on_type_changed)
        
        right_lay.addWidget(topbar)

        # ── Stack ──
        self.stack = QStackedWidget()
        self.stack.addWidget(LibraryPanel())
        self.stack.addWidget(ExplorePanel())
        self.stack.addWidget(DisplaysPanel())
        self.stack.addWidget(SettingsPanel())
        self.stack.addWidget(AboutPanel())
        right_lay.addWidget(self.stack)

        # ── Floating Dock ──
        dock_container = QFrame()
        dock_container.setFixedHeight(80)
        dock_container.setStyleSheet("background: transparent;")
        dock_c_lay = QHBoxLayout(dock_container)
        dock_c_lay.setContentsMargins(24, 8, 24, 20)
        
        ctrl_frame = QFrame()
        ctrl_frame.setObjectName("FloatingDock")
        ctrl = QHBoxLayout(ctrl_frame)
        ctrl.setContentsMargins(20, 0, 20, 0)
        ctrl.setSpacing(16)
        
        self.active_lbl = QLabel("Ready")
        self.active_lbl.setStyleSheet("color: #e4e1e9; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: bold;")
        ctrl.addWidget(self.active_lbl)
        ctrl.addStretch()

        # Playback controls
        b_prev = QPushButton("⏮")
        b_prev.setObjectName("PlayBtn")
        b_prev.setFixedSize(32, 32)
        b_prev.clicked.connect(lambda: aura("prev"))
        ctrl.addWidget(b_prev)
        
        b_play = QPushButton("⏸")
        b_play.setObjectName("PlayBtn")
        b_play.setFixedSize(40, 40)
        b_play.clicked.connect(lambda: aura("toggle-pause"))
        ctrl.addWidget(b_play)
        
        b_next = QPushButton("⏭")
        b_next.setObjectName("PlayBtn")
        b_next.setFixedSize(32, 32)
        b_next.clicked.connect(lambda: aura("next"))
        ctrl.addWidget(b_next)
        
        ctrl.addStretch()
        
        self.color_btn = QPushButton(" ")
        self.color_btn.setFixedSize(16, 16)
        self.color_btn.setStyleSheet("background-color: #ff5168; border-radius: 8px;")
        ctrl.addWidget(self.color_btn)

        def _pick_color():
            from PyQt6.QtWidgets import QColorDialog
            from PyQt6.QtGui import QColor
            color = QColorDialog.getColor(QColor(ACCENT), self, "Choose Accent Color")
            if color.isValid():
                # Apply locally regardless of Auto-Theming
                r, g, b = color.red(), color.green(), color.blue()
                
                # Apply globally via aura
                hex_c = f"#{r:02x}{g:02x}{b:02x}"
                dim_hex = f"#{max(0,r-40):02x}{max(0,g-40):02x}{max(0,b-40):02x}"
                bright_hex = f"#{min(255,r+40):02x}{min(255,g+40):02x}{min(255,b+40):02x}"
                script = f"""
source ~/.config/aura/lib/util.sh
source ~/.config/aura/lib/accent.sh
palette="accent={hex_c} dim={dim_hex} bright={bright_hex} on=#000000 text=#ffffff"
aura_theme_write "$palette"
"""
                subprocess.Popen(["bash", "-c", script])
                
                # Disable Auto-Theming AFTER applying so guard doesn't overwrite it
                conf_set("THEME", "0")
                
                # Temporarily bypass the THEME=0 check to update UI
                conf_set("THEME", "1")
                self.apply_dynamic_theme(r, g, b)
                conf_set("THEME", "0")
                
        self.color_btn.clicked.connect(_pick_color)

        dock_c_lay.addStretch()
        dock_c_lay.addWidget(ctrl_frame)
        dock_c_lay.setStretchFactor(ctrl_frame, 1)
        dock_c_lay.addStretch()

        right_lay.addWidget(dock_container)
        root_lay.addWidget(right_widget)

    def switch_view(self, index):
        self.stack.setCurrentIndex(index)
        for i, btn in enumerate(self.nav_btns):
            btn.setChecked(i == index)

    def start_download(self, url):
        if not url: return
        self.active_lbl.setText("DOWNLOADING…")
        self.active_lbl.setStyleSheet(
            "color:#f9e2af; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:11px; letter-spacing:1px;")

        target = self.target_mon_cb.currentData() if hasattr(self, "target_mon_cb") else ""

        def run():
            cmd = f"{AURA_BIN} fetch '{url}'"
            if target: cmd += f" '{target}'"
            res = subprocess.run(cmd, shell=True, text=True, capture_output=True)
            def done():
                if res.returncode == 0:
                    self.active_lbl.setText("DOWNLOADED · APPLIED")
                    self.active_lbl.setStyleSheet(
                        "color:#a6e3a1; font-family:'JetBrains Mono','Fira Mono',monospace;"
                        "font-size:11px; letter-spacing:1px;")
                else:
                    err = res.stderr.split('\n')[0][:40]
                    self.active_lbl.setText(f"ERROR · {err.upper()}")
                    self.active_lbl.setStyleSheet(
                        "color:#f38ba8; font-family:'JetBrains Mono','Fira Mono',monospace;"
                        "font-size:11px; letter-spacing:1px;")
            QTimer.singleShot(0, done)
        threading.Thread(target=run, daemon=True).start()

    # ── IPC Control ──
    def _send_ipc(self, prop, val, target=None):
        """Send property change to running mpv instances via aura-ipc."""
        try:
            runtime = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"aura-{os.getuid()}")
            if not os.path.exists(runtime): return
            ipc_bin = os.path.expanduser("~/.config/aura/bin/aura-ipc")
            for f in os.listdir(runtime):
                if f.endswith(".sock"):
                    if target and target != "" and f"mp-{target}.sock" != f:
                        continue
                    sock = os.path.join(runtime, f)
                    subprocess.Popen([ipc_bin, sock, "--set", prop, str(val)], 
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            print(f"IPC Error: {e}")

    # ── Thumbnail watcher (correct color extraction) ──
    # aura writes ~/.cache/aura-current.webp on every wallpaper change.
    # We run our OWN ColorThief on that file instead of reading accent.env,
    # because aura's dominant-color algorithm produces incorrect purple for most wallpapers.
    def _run_colorthief(self, img_path):
        """Run ColorThief in a subprocess (NEVER in thread — GIL + X11 pointer grab = freeze)."""
        code = f"""
from colorthief import ColorThief
import colorsys, sys
try:
    palette = ColorThief('{img_path}').get_palette(color_count=8, quality=8)
    def score(c):
        h, l, s = colorsys.rgb_to_hls(c[0]/255, c[1]/255, c[2]/255)
        if l < 0.15: return 0.0   # skip very dark colors
        if l > 0.92: return 0.0   # skip near-white
        return (s * 1.5) + (l * 0.5)
    best = max(palette, key=score)
    print(f'{{best[0]}} {{best[1]}} {{best[2]}}')
except Exception as e:
    print('203 166 247', file=sys.stderr)
    print('203 166 247')
"""
        try:
            import subprocess as _sp
            out = _sp.check_output(["python3", "-c", code], text=True,
                                   stderr=_sp.DEVNULL, timeout=8).strip()
            r, g, b = map(int, out.split())
            self.theme_ready.emit(r, g, b)
        except Exception as e:
            print(f"[aura-studio] colorthief failed: {e}")

    def _load_from_thumb(self):
        """Extract color from current wallpaper thumbnail and apply theme."""
        if not os.path.exists(self._thumb_path):
            return
        threading.Thread(
            target=self._run_colorthief,
            args=(self._thumb_path,),
            daemon=True).start()

    def _check_thumb(self):
        """Poll thumbnail mtime every 1.5s; update only when wallpaper changed."""
        try:
            if not os.path.exists(self._thumb_path):
                return
            mtime = os.path.getmtime(self._thumb_path)
            if mtime != self._thumb_mtime:
                self._thumb_mtime = mtime
                self._load_from_thumb()
        except Exception:
            pass

    # ── Auto-Theming (from WallpaperCard.on_apply) ──
    # CRITICAL: ColorThief must run in a subprocess, NEVER in a thread.
    # threading.Thread + heavy Python (GIL) + X11 pointer grab = frozen desktop.
    def extract_color_async(self, jpg_path):
        def _run():
            try:
                code = f"""
from colorthief import ColorThief
import colorsys
try:
    palette = ColorThief('{jpg_path}').get_palette(color_count=6, quality=10)
    def score(c):
        h, l, s = colorsys.rgb_to_hls(c[0]/255, c[1]/255, c[2]/255)
        if l < 0.15: return 0.0
        if l > 0.92: return 0.0
        return (s * 1.5) + (l * 0.5)
    best = max(palette, key=score)
    print(f'{{best[0]}} {{best[1]}} {{best[2]}}')
except Exception:
    print('203 166 247')
"""
                import subprocess as _sp
                out = _sp.check_output(["python3", "-c", code], text=True).strip()
                r, g, b = map(int, out.split())
                self.theme_ready.emit(r, g, b)
            except Exception as e:
                print(f"[aura-studio] extract_color: {e}")
        threading.Thread(target=_run, daemon=True).start()

    # CRITICAL: Use findChild to update only specific containers.
    # self.setStyleSheet(global_qss) with hundreds of cards = app freeze.
    def apply_dynamic_theme(self, r, g, b):
        if not int(conf_get("THEME", "0")):
            return
            
        import colorsys
        h, l, s = colorsys.rgb_to_hls(r/255, g/255, b/255)
        if l < 0.7: l = 0.7
        if s < 0.6: s = 0.6
        r_n, g_n, b_n = colorsys.hls_to_rgb(h, l, s)
        r_bright, g_bright, b_bright = int(r_n*255), int(g_n*255), int(b_n*255)
            
        global ACCENT
        acc = '#{:02x}{:02x}{:02x}'.format(r_bright, g_bright, b_bright)
        ACCENT = acc
        
        dynamic_bg = conf_get("DYNAMIC_BG", "1") == "1"
        if dynamic_bg:
            bg_main    = f"rgba({int(r*.07)},{int(g*.07)},{int(b*.07)},225)"
            bg_sidebar = f"rgba({int(r*.04)},{int(g*.04)},{int(b*.04)},215)"
            bg_ctrl    = f"rgba({int(r*.05)},{int(g*.05)},{int(b*.05)},215)"
        else:
            bg_main    = "rgba(13,13,13,220)"
            bg_sidebar = "rgba(8,8,8,210)"
            bg_ctrl    = "rgba(8,8,8,210)"

        current_theme_name = conf_get("APP_THEME", "Vellum (Default)")
        # Rebuild the ENTIRE stylesheet cleanly with the dynamic overrides
        full_css = build_theme_stylesheet(current_theme_name, dynamic_acc=acc, dyn_bg=bg_main, dyn_sb=bg_sidebar, dyn_ctrl=bg_ctrl)
        
        # Apply the clean stylesheet
        self.setStyleSheet(full_css)

        if hasattr(self, "color_btn"):
            self.color_btn.setStyleSheet(f"background-color: {acc}; border-radius: 4px; border: 1px solid #1a1a1a;")
        
        if hasattr(self, "active_lbl"):
            self.active_lbl.setStyleSheet(
                f"color:{acc}; font-family:'JetBrains Mono','Fira Mono',monospace;"
                f"font-size:11px; letter-spacing:1px;")

    # ── Drag (solo en zonas vacías) ──
    def _can_drag(self, pos):
        child = self.childAt(pos)
        while child:
            if isinstance(child, (QPushButton, QLineEdit, QScrollArea, ToggleSwitch)):
                return False
            child = child.parentWidget()
        return True

    def mousePressEvent(self, e):
        if e.button() == LB:
            pos = e.position().toPoint() if hasattr(e, 'position') else e.pos()
            if self._can_drag(pos):
                self._is_dragging = True
                gpos = e.globalPosition().toPoint() if hasattr(e, 'globalPosition') else e.globalPos()
                self._drag_pos = gpos - self.frameGeometry().topLeft()
                e.accept()
                return
        e.ignore()
        super().mousePressEvent(e)

    def mouseMoveEvent(self, e):
        if getattr(self, '_is_dragging', False):
            gpos = e.globalPosition().toPoint() if hasattr(e, 'globalPosition') else e.globalPos()
            self.move(gpos - self._drag_pos)
            e.accept()
            return
        super().mouseMoveEvent(e)

    def mouseReleaseEvent(self, e):
        if getattr(self, '_is_dragging', False):
            self._is_dragging = False
            e.accept()
            return
        super().mouseReleaseEvent(e)

    def _center(self):
        s = QApplication.primaryScreen().geometry()
        self.move((s.width()-self.width())//2, (s.height()-self.height())//2)

    def closeEvent(self, event):
        event.ignore()
        self.hide()

    # ── Drag & Drop Import ──
    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls():
            e.acceptProposedAction()

    def dropEvent(self, e):
        urls = e.mimeData().urls()
        if not urls: return
        file_path = urls[0].toLocalFile()
        if not file_path.lower().endswith((".mp4", ".mkv", ".webm")):
            return
        
        self.active_lbl.setText(f"⚙  IMPORTING {os.path.basename(file_path)[:15]}...")
        threading.Thread(target=self._import_video, args=(file_path,), daemon=True).start()

    def _import_video(self, source_path):
        try:
            filename = os.path.basename(source_path)
            # if not mp4, we should ideally convert, but for now just copy if it's mp4, or maybe bspwm handles others?
            # aura usually expects .mp4. Let's just copy it to WALL_DIR
            dest_video = os.path.join(WALL_DIR, filename)
            
            # Avoid copying if it's already there
            if os.path.abspath(source_path) != os.path.abspath(dest_video):
                shutil.copy2(source_path, dest_video)
            
            dest_jpg = dest_video.replace(os.path.splitext(dest_video)[1], ".jpg")
            # extract thumbnail using ffmpeg
            subprocess.run([
                "ffmpeg", "-y", "-i", dest_video,
                "-ss", "00:00:01", "-vframes", "1",
                "-q:v", "2", dest_jpg
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            # Use QTimer to safely reload UI on main thread
            QTimer.singleShot(0, self.load_wallpapers)
            QTimer.singleShot(0, lambda: self.active_lbl.setText("▶  IMPORT COMPLETE"))
        except Exception as err:
            print(f"Import failed: {err}")


if __name__ == "__main__":
    lock_sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"aura-studio-{os.getuid()}.sock")
    
    import socket
    try:
        # If we can't connect, no other instance is running
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(lock_sock)
        s.send(b"show")
        s.close()
        sys.exit(0)
    except Exception:
        pass

    # Start our own listener
    if os.path.exists(lock_sock):
        os.remove(lock_sock)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(lock_sock)
    srv.listen(1)
    
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    w = AuraStudio()
    w.show()
    
    def listen_loop():
        while True:
            try:
                conn, _ = srv.accept()
                data = conn.recv(1024)
                if data == b"show":
                    # PyQt must manipulate UI in main thread
                    QTimer.singleShot(0, w.showNormal)
                    QTimer.singleShot(0, w.raise_)
                    QTimer.singleShot(0, w.activateWindow)
                conn.close()
            except Exception:
                pass
    import threading
    threading.Thread(target=listen_loop, daemon=True).start()
    
    sys.exit(app.exec() if hasattr(app, 'exec') else app.exec_())
