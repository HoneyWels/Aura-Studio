        iv_row.addSpacing(8)
        iv_row.addWidget(save_iv)
        layout.addLayout(iv_row)

        layout.addSpacing(8)
        bat_row = QHBoxLayout()
        bat_row.addWidget(mono_lbl("BATTERY PAUSE BELOW (%)", "#333333", 11, 1))
        bat_row.addStretch()
        self.bat_input = QLineEdit(conf_get("BATTERY_PAUSE_BELOW", "60"))
        self.bat_input.setFixedWidth(60)
        self.bat_input.setFixedHeight(28)
        bat_row.addWidget(self.bat_input)
        save_bat = accent_btn("SAVE")
        save_bat.setFixedHeight(28)
        save_bat.clicked.connect(
            lambda: conf_set("BATTERY_PAUSE_BELOW", self.bat_input.text().strip()))
        bat_row.addWidget(save_bat)
        layout.addLayout(bat_row)
        
        layout.addSpacing(8)
        slide_row = QHBoxLayout()
        slide_row.addWidget(mono_lbl("AUTO ROTATE (min, 0=off)", "#333333", 11, 1))
        slide_row.addStretch()
        self.slide_input = QLineEdit(conf_get("SLIDESHOW", "0"))
        self.slide_input.setFixedWidth(60)
        self.slide_input.setFixedHeight(28)
        slide_row.addWidget(self.slide_input)
        save_slide = accent_btn("SAVE")
        save_slide.setFixedHeight(28)
        save_slide.clicked.connect(
            lambda: conf_set("SLIDESHOW", self.slide_input.text().strip()))
        slide_row.addSpacing(8)
        slide_row.addWidget(save_slide)
        layout.addLayout(slide_row)
        layout.addStretch()

    def _make_row(self, label, desc, key, initial):
        row = QFrame()
        row.setObjectName("SettingRow")
        row.setFixedHeight(64)
        h = QHBoxLayout(row)
        h.setContentsMargins(16, 0, 16, 0)

        texts = QVBoxLayout()
        lbl = QLabel(label)
        lbl.setStyleSheet(
            "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:12px; font-weight:bold; letter-spacing:1px;")
        desc_lbl = QLabel(desc)
        desc_lbl.setWordWrap(True)
        desc_lbl.setStyleSheet(
            "color:#2a2a2a; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        texts.addWidget(lbl)
        texts.addWidget(desc_lbl)
        h.addLayout(texts)
        h.addStretch()

        toggle = ToggleSwitch(initial=initial)
        def on_toggle(val, k=key):
            conf_set(k, "1" if val else "0")
            if k == "AUTOSTART":
                # Directly update gh0stzk's bspwm config to set the engine
                cfg = os.path.expanduser("~/.config/bspwm/rices/wels/theme-config.bash")
                if os.path.exists(cfg):
                    engine_val = "Aura" if val else "Theme"
                    subprocess.run(["sed", "-i", f's/^ENGINE=.*/ENGINE="{engine_val}"/', cfg])
        toggle.toggled.connect(on_toggle)
        h.addWidget(toggle)
        return row


