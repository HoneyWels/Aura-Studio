        content = QWidget()
        content.setStyleSheet("background: transparent;")
        
        layout = QVBoxLayout(content)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(12)
        
        scroll.setWidget(content)
        main_layout.addWidget(scroll)

        layout.addWidget(section_title("settings"))
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)
        layout.addSpacing(8)

        opts = [
            ("AUTOSTART",        "Start animated wallpaper engine on boot", "AUTOSTART",    "1"),
            ("AUTO-THEMING",     "Sync accent color from wallpaper", "THEME",        "1"),
            ("DYNAMIC BACKGROUND","Tint app background with accent (disable on low-end PCs)", "DYNAMIC_BG", "1"),
            ("AUTO PAUSE",       "Pause on fullscreen windows",       "AUTO_PAUSE",   "1"),
            ("BATTERY SAVER",    "Pause below battery threshold",     "BATTERY_PAUSE","1"),
            ("START PAUSED",     "Begin session paused",              "START_PAUSED", "0"),
        ]

        # Sync AUTOSTART key with actual bspwm config before rendering
        cfg = os.path.expanduser("~/.config/bspwm/rices/wels/theme-config.bash")
        if os.path.exists(cfg):
            with open(cfg, "r") as f:
                if 'ENGINE="Aura"' in f.read():
                    conf_set("AUTOSTART", "1")
                else:
                    conf_set("AUTOSTART", "0")

        for label, desc, key, default in opts:
            val = conf_get(key, default)
            layout.addWidget(self._make_row(label, desc, key, val == "1"))

        layout.addSpacing(16)
        
        # Brightness Slider
        bri_row = QFrame()
        bri_row.setObjectName("SettingRow")
        bri_row.setFixedHeight(64)
        h = QHBoxLayout(bri_row)
        h.setContentsMargins(16, 0, 16, 0)
        
        texts = QVBoxLayout()
        lbl = QLabel("DIM / BRIGHTNESS")
        lbl.setStyleSheet("color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:12px; font-weight:bold; letter-spacing:1px;")
        desc_lbl = QLabel("Adjust wallpaper brightness (live)")
        desc_lbl.setStyleSheet("color:#2a2a2a; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        texts.addWidget(lbl)
        texts.addWidget(desc_lbl)
        h.addLayout(texts)
        h.addStretch()
        
        self.bri_slider = QSlider(Qt.Orientation.Horizontal if hasattr(Qt, 'Orientation') else Qt.Horizontal)
        self.bri_slider.setFixedSize(120, 20)
        self.bri_slider.setFocusPolicy(NoFocus)
        self.bri_slider.setRange(-100, 100)
        self.bri_slider.setValue(int(conf_get("BRIGHTNESS", "0")))
        
        def _on_bri_change(v):
            conf_set("BRIGHTNESS", str(v))
            main_win = self.window()
            if hasattr(main_win, "_send_ipc"):
                main_win._send_ipc("brightness", v)
                
        self.bri_slider.valueChanged.connect(_on_bri_change)
        h.addWidget(self.bri_slider)
        
        layout.addWidget(bri_row)

        layout.addSpacing(20)
        layout.addWidget(section_title("intervals"))
        layout.addSpacing(8)

        iv_row = QHBoxLayout()
        iv_row.addWidget(mono_lbl("THEMING INTERVAL (sec)", "#333333", 11, 1))
        iv_row.addStretch()
        self.interval_input = QLineEdit(conf_get("THEME_INTERVAL", "15"))
        self.interval_input.setFixedWidth(60)
        self.interval_input.setFixedHeight(28)
        iv_row.addWidget(self.interval_input)
        save_iv = accent_btn("SAVE")
        save_iv.setFixedHeight(28)
