# ─────────────────────────────────────────────── helpers ───
def conf_get(key, default=""):
    try:
        out = subprocess.check_output(
            f"grep -E '^{key}=' {CONF_PATH} | cut -d= -f2", shell=True, text=True).strip()
        return out if out else default
    except:
        return default

def conf_set(key, value):
    subprocess.run(
        f"sed -i 's|^{key}=.*|{key}={value}|' {CONF_PATH}", shell=True)

def aura(cmd):
    subprocess.Popen(f"{AURA_BIN} {cmd}", shell=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def mono_lbl(text, color="#444444", size=11, spacing=1):
    """Helper: monospace label."""
    lbl = QLabel(text)
    lbl.setStyleSheet(
        f"color:{color}; font-family:'JetBrains Mono','Fira Mono',monospace;"
        f"font-size:{size}px; letter-spacing:{spacing}px;")
    return lbl

def section_title(text):
    lbl = QLabel(text.upper())
    lbl.setStyleSheet(
        "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace;"
        "font-size:10px; letter-spacing:3px; font-weight:bold;")
    return lbl

def accent_btn(text, name="ApplyBtn"):
    btn = QPushButton(text)
    btn.setObjectName(name)
    btn.setFocusPolicy(NoFocus)
    btn.setCursor(QCursor(HC))
    return btn

# ─────────────────────────────────────────────── Toggle ───
def apply_top_rounded_mask(px, radius=12):
    try:
        from PyQt6.QtGui import QPixmap, QPainter, QPainterPath, QColor
        from PyQt6.QtCore import Qt
    except ImportError:
        from PyQt5.QtGui import QPixmap, QPainter, QPainterPath, QColor
        from PyQt5.QtCore import Qt
    target = QPixmap(px.size())
    target.fill(Qt.GlobalColor.transparent if hasattr(Qt, 'GlobalColor') else Qt.transparent)
    painter = QPainter(target)
    try:
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    except:
        painter.setRenderHint(QPainter.Antialiasing)
    path = QPainterPath()
    path.addRoundedRect(0, 0, px.width(), px.height() + radius, radius, radius)
    painter.setClipPath(path)
    painter.drawPixmap(0, 0, px)
    painter.end()
    return target

class ToggleSwitch(QWidget):
    toggled = pyqtSignal(bool)
    def __init__(self, initial=False, parent=None):
        super().__init__(parent)
        self.setFixedSize(44, 24)
        self._on = initial

    def isChecked(self): return self._on
    def setChecked(self, val):
        self._on = val
        self.update()

    def mousePressEvent(self, e):
        self._on = not self._on
        self.update()
        self.toggled.emit(self._on)

    def paintEvent(self, e):
        try:
            from PyQt6.QtGui import QPainter, QPainterPath, QBrush
        except ImportError:
            from PyQt5.QtGui import QPainter, QPainterPath, QBrush
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing if hasattr(QPainter, 'RenderHint') else QPainter.Antialiasing)
        track_color = QColor(ACCENT) if self._on else QColor("#1a1a1a")
        p.setBrush(QBrush(track_color))
        p.setPen(Qt.PenStyle.NoPen if hasattr(Qt, 'PenStyle') else Qt.NoPen)
        p.drawRoundedRect(0, 4, 44, 16, 8, 8)
        knob_x = 22 if self._on else 2
        knob_color = QColor("#0d0d0d") if self._on else QColor("#333333")
        p.setBrush(QBrush(knob_color))
        p.drawEllipse(knob_x, 2, 20, 20)
        p.end()

# ─────────────────────────────────────────────── CARDS ───
class WallpaperCard(QFrame):
    def __init__(self, video_path, panel=None, parent=None):
        super().__init__(parent)
        self.panel = panel
        self.setObjectName("Card")
        self.video_path = video_path
        is_video = video_path.lower().endswith((".mp4", ".webm", ".mkv"))
        self.setFixedSize(268, 230)
        self.setCursor(QCursor(HC))
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # ── Thumbnail (16:9) ──────────────────────────────────────────────
        thumb_container = QFrame()
        thumb_container.setFixedSize(268, 151)
        thumb_container.setStyleSheet("background: #1b1b20; border-radius: 12px 12px 0 0;")
        tc_lay = QVBoxLayout(thumb_container)
        tc_lay.setContentsMargins(0, 0, 0, 0)

        jpg_path = video_path.replace(".mp4", ".jpg").replace(".webm", ".jpg").replace(".mkv", ".jpg") if is_video else video_path
        self.thumb = QLabel()
        self.thumb.setFixedSize(268, 151)
        self.thumb.setAlignment(AF.AlignCenter)
        self.thumb.setStyleSheet("background: transparent; border: none;")
        if os.path.exists(jpg_path):
            if hasattr(panel, "request_thumb"):
                panel.request_thumb(jpg_path, self)
            else:
                try:
                    from PyQt6.QtGui import QImageReader
                    from PyQt6.QtCore import QSize
                    from PyQt6.QtGui import QPixmap
                except:
                    from PyQt5.QtGui import QImageReader
                    from PyQt5.QtCore import QSize
                    from PyQt5.QtGui import QPixmap
                reader = QImageReader(jpg_path)
                reader.setScaledSize(QSize(268, 151))
                img = reader.read()
                pm = QPixmap.fromImage(img)
                pm = apply_top_rounded_mask(pm)
                self.thumb.setPixmap(pm)

        tc_lay.addWidget(self.thumb)

        # Top badges overlay (stacked on thumbnail)
        badge_row = QHBoxLayout()
        badge_row.setContentsMargins(8, 8, 8, 0)
        badge_row.setSpacing(4)

        if is_video:
            b_live = QLabel("● LIVE")
            b_live.setStyleSheet("background: rgba(14,14,19,0.85); color:#ff5168; border-radius: 10px; padding: 2px 8px; font-family: 'JetBrains Mono',monospace; font-size:10px; font-weight:bold;")
        else:
            b_live = QLabel("◆ STATIC")
            b_live.setStyleSheet("background: rgba(14,14,19,0.85); color:#00dbe9; border-radius: 10px; padding: 2px 8px; font-family: 'JetBrains Mono',monospace; font-size:10px; font-weight:bold;")
        badge_row.addWidget(b_live)
        badge_row.addStretch()

        try:
            size_mb = os.path.getsize(video_path) / (1024*1024)
            b_size = QLabel(f"{size_mb:.0f}MB")
        except:
            b_size = QLabel("?MB")
        b_size.setStyleSheet("background: rgba(14,14,19,0.85); color:#e7bcbd; border-radius: 10px; padding: 2px 8px; font-family: 'JetBrains Mono',monospace; font-size:10px;")
        badge_row.addWidget(b_size)

        # Overlay widget to position badges on top of thumb
        overlay = QWidget(thumb_container)
        overlay.setGeometry(0, 0, 268, 151)
        overlay.setStyleSheet("background: transparent;")
        overlay.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        overlay_lay = QVBoxLayout(overlay)
        overlay_lay.setContentsMargins(0, 0, 0, 0)
        overlay_lay.addLayout(badge_row)
        overlay_lay.addStretch()

        outer.addWidget(thumb_container)

        # ── Metadata strip ────────────────────────────────────────────────
        meta = QFrame()
        meta.setStyleSheet("background: rgba(27,27,32,0.9); border-radius: 0 0 12px 12px;")
        meta_lay = QVBoxLayout(meta)
        meta_lay.setContentsMargins(12, 10, 12, 10)
        meta_lay.setSpacing(6)

        filename = os.path.basename(video_path)
        title = filename.replace(".mp4","").replace(".webm","").replace(".mkv","").replace("-"," ").replace("."," ").title()
        if len(title) > 26: title = title[:23] + "…"

        title_row = QHBoxLayout()
        t = QLabel(title)
        t.setObjectName("CardTitle")
        is_fav = self.video_path in load_favs()
        self.fav_btn = QPushButton("♥" if is_fav else "♡")
        self.fav_btn.setFixedSize(20, 20)
        self.fav_btn.setFocusPolicy(NoFocus)
        self.fav_btn.setCursor(QCursor(HC))
        self.fav_btn.setStyleSheet(
            "QPushButton { background: transparent; color: #ff5168; border: none; font-size: 14px; }"
            if is_fav else
            "QPushButton { background: transparent; color: #5d3f40; border: none; font-size: 14px; }"
            "QPushButton:hover { color: #ff5168; }"
        )
        self.fav_btn.clicked.connect(self.on_favorite)
        title_row.addWidget(t)
        title_row.addStretch()
        title_row.addWidget(self.fav_btn)
        meta_lay.addLayout(title_row)

        # Action buttons
        btn_row = QHBoxLayout()
        btn_row.setSpacing(6)
        apply_btn = QPushButton("▶  Apply")
        apply_btn.setObjectName("ApplyBtn")
        apply_btn.setFixedHeight(28)
        apply_btn.setFocusPolicy(NoFocus)
        apply_btn.setCursor(QCursor(HC))
        apply_btn.clicked.connect(self.on_apply)

        trash_btn = QPushButton("✕")
        trash_btn.setFixedSize(28, 28)
        trash_btn.setFocusPolicy(NoFocus)
        trash_btn.setCursor(QCursor(HC))
        trash_btn.setStyleSheet("background: rgba(255,255,255,5); color: #5d3f40; border: none; border-radius: 6px; font-size:13px;")
        trash_btn.clicked.connect(self.on_delete)

        btn_row.addWidget(apply_btn)
        btn_row.addWidget(trash_btn)
        meta_lay.addLayout(btn_row)
        outer.addWidget(meta)

    def on_apply(self):
        main_win = self.window()
        target = main_win.target_mon_cb.currentData() if hasattr(main_win, "target_mon_cb") else ""
        args = [AURA_BIN, "apply", self.video_path]
        if target: args.append(target)
        subprocess.Popen(args)
        main_win = self.window()
        if hasattr(main_win, "active_lbl"):
            t = os.path.basename(self.video_path).replace(".mp4","").replace("-"," ")
            main_win.active_lbl.setText(f"▶  {t[:28].upper()}")
        # Immediately extract color from the local JPG thumbnail using our own
        # bright/saturated algorithm — independent of aura's broken dominant-color.
        jpg = self.video_path.replace(".mp4", ".jpg")
        if os.path.exists(jpg) and hasattr(main_win, "_run_colorthief"):
            threading.Thread(
                target=main_win._run_colorthief, args=(jpg,), daemon=True).start()


    def _apply_thumb(self, pm):
        self.thumb.setPixmap(pm)

    def on_favorite(self):
        favs = load_favs()
        if self.video_path in favs:
            favs.remove(self.video_path)
        else:
            favs.append(self.video_path)
        save_favs(favs)
        # Tell main window to reload (using window() since Card is deeply nested)
        main_win = self.window()
        if hasattr(main_win, "load_wallpapers"):
            main_win.load_wallpapers()

    def on_delete(self):
        if self.video_path.lower().endswith((".mp4", ".webm", ".mkv")):
            jpg = self.video_path.replace(".mp4", ".jpg").replace(".webm", ".jpg").replace(".mkv", ".jpg")
        else:
            jpg = self.video_path
        try:
            os.remove(self.video_path)
            if os.path.exists(jpg) and jpg != self.video_path: os.remove(jpg)
            if self.panel:
                self.panel.remove_card(self)
            else:
                self.setParent(None)
                self.deleteLater()
        except Exception as ex:
            print(f"Error borrando: {ex}")

# ─────────────────────────────────────────────── PANELS ───
class LibraryPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 16, 16)
        layout.setSpacing(16)

        header = QHBoxLayout()
        header.addWidget(section_title("library"))
        header.addStretch()
        
        # Folder buttons
        refresh_btn = QPushButton("🔄")
        refresh_btn.setFixedSize(32, 32)
        refresh_btn.setToolTip("Refresh Library")
        refresh_btn.setStyleSheet("background:transparent; font-size:16px;")
        refresh_btn.setCursor(QCursor(HC))
        def _refresh():
            for i in reversed(range(self.grid_lay.count())):
                widget = self.grid_lay.itemAt(i).widget()
                if widget:
                    widget.setParent(None)
                    widget.deleteLater()
            self.all_cards.clear()
            self.load_wallpapers()
        refresh_btn.clicked.connect(_refresh)
        header.addWidget(refresh_btn)

        open_btn = QPushButton("📂")
        open_btn.setFixedSize(32, 32)
        open_btn.setToolTip("Open Global WelsPapers Folder")
        open_btn.setStyleSheet("background:transparent; font-size:16px;")
        open_btn.setCursor(QCursor(HC))
        def _open_folder():
            import subprocess
            subprocess.Popen(["xdg-open", WALL_DIR])
        open_btn.clicked.connect(_open_folder)
        header.addWidget(open_btn)
        # Removed add button to prevent aura.conf corruption
        
        layout.addLayout(header)

        # Separator
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)

        # Grid
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        
        self.scroll.setVerticalScrollBarPolicy(SBOff)
        self.scroll.setHorizontalScrollBarPolicy(SBOff)
        
        self.thumb_signals = ThumbWorkerSignals()
        self.thumb_signals.result.connect(self._on_thumb_loaded)
        self.thread_pool = QThreadPool.globalInstance()
        self.thumb_reqs = {}
        self.thumb_cache = {}

        self.grid_w = QWidget()
        self.grid_w.setStyleSheet("background: transparent;")
        self.grid_lay = QGridLayout(self.grid_w)
        self.grid_lay.setSpacing(16)
        self.grid_lay.setAlignment(AF.AlignTop | AF.AlignLeft)
        self.all_cards = []
        self._current_filter_text = ""
        self._current_filter_type = 0
        self.load_wallpapers()
        self.scroll.setWidget(self.grid_w)
        layout.addWidget(self.scroll)


    def request_thumb(self, path, card):
        if path in self.thumb_cache:
            card._apply_thumb(self.thumb_cache[path])
            return
        self.thumb_reqs.setdefault(path, []).append(card)
        if len(self.thumb_reqs[path]) == 1:
            worker = ThumbWorker(path, self.thumb_signals)
            self.thread_pool.start(worker)

    def _on_thumb_loaded(self, path, img):
        try:
            from PyQt6.QtGui import QPixmap
        except:
            from PyQt5.QtGui import QPixmap
        pm = QPixmap.fromImage(img)
        pm = apply_top_rounded_mask(pm)
        self.thumb_cache[path] = pm
        for card in self.thumb_reqs.pop(path, []):
            card._apply_thumb(pm)

    def load_wallpapers(self):
        try:
            raw = subprocess.check_output(
                f"{AURA_BIN} pool --kind all", shell=True, text=True, stderr=subprocess.DEVNULL)
            files = [line.strip() for line in raw.splitlines()
                     if line.strip().startswith("/") and line.strip().lower().endswith((".mp4", ".webm", ".mkv", ".jpg", ".jpeg", ".png", ".webp"))]
        except Exception:
            if not os.path.exists(WALL_DIR):
                return
            files = sorted(
                os.path.join(WALL_DIR, f) for f in os.listdir(WALL_DIR)
                if f.lower().endswith((".mp4", ".webm", ".mkv", ".jpg", ".jpeg", ".png", ".webp"))
                and os.path.getsize(os.path.join(WALL_DIR, f)) > 30000)

        # Sort: favorites first, then alphabetical
        favs = set(load_favs())
        files.sort(key=lambda x: (0 if x in favs else 1, os.path.basename(x).lower()))

        for idx, path in enumerate(files):
            if path.lower().endswith((".mp4", ".webm", ".mkv")):
                jpg = path.replace(".mp4", ".jpg").replace(".webm", ".jpg").replace(".mkv", ".jpg")
                if not os.path.exists(jpg):
                    subprocess.Popen(
                        ["ffmpeg", "-y", "-i", path, "-vframes", "1", "-q:v", "2",
                         jpg, "-loglevel", "error"])
            else:
                jpg = path
            card = WallpaperCard(path, panel=self)
            self.all_cards.append(card)
            self.grid_lay.addWidget(card, idx // 3, idx % 3)

    def remove_card(self, card):
        if card in self.all_cards:
            self.all_cards.remove(card)
        card.setParent(None)
        card.deleteLater()
        self.reflow_grid()

    def reflow_grid(self):
        # Remove all items from grid layout (they are still in all_cards list)
        for i in reversed(range(self.grid_lay.count())):
            item = self.grid_lay.itemAt(i)
            if item.widget():
                self.grid_lay.removeItem(item)
        # Re-add all visible cards sequentially to close gaps
        alive_cards = [c for c in self.all_cards if not c.isHidden()]
        for idx, c in enumerate(alive_cards):
            self.grid_lay.addWidget(c, idx // 3, idx % 3)

    def _filter_type(self, type_idx):
        # 0=ALL, 1=LIVE, 2=STATIC
        self._current_filter_type = type_idx
        self._apply_filters()

    def filter_cards(self, text):
        self._current_filter_text = text.lower()
        self._apply_filters()

    def _apply_filters(self):
        txt = self._current_filter_text
        t_idx = self._current_filter_type
        for card in self.all_cards:
            name = os.path.basename(card.video_path).lower()
            is_video = card.video_path.lower().endswith((".mp4", ".webm", ".mkv"))
            
            match_txt = (txt in name)
            match_type = True
            if t_idx == 1 and not is_video: match_type = False
            if t_idx == 2 and is_video: match_type = False
            
            card.setVisible(match_txt and match_type)
        self.reflow_grid()


class OnlineCard(QFrame):
    _sem = threading.Semaphore(6)
    _thumb_bytes = pyqtSignal(bytes)

    def __init__(self, title, thumb_url, live_url, static_url, parent=None):
        super().__init__(parent)
        self.setObjectName("Card")
        self.live_url = live_url
        self.static_url = static_url
        self.setFixedSize(268, 230)
        self.setCursor(QCursor(HC))
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self._thumb_bytes.connect(self._render_thumb)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # ── Thumbnail (16:9) ──────────────────────────────────────────────
        thumb_container = QFrame()
        thumb_container.setFixedSize(268, 151)
        thumb_container.setStyleSheet("background: #1b1b20; border-radius: 12px 12px 0 0;")
        tc_lay = QVBoxLayout(thumb_container)
        tc_lay.setContentsMargins(0, 0, 0, 0)

        self.thumb = QLabel("…")
        self.thumb.setFixedSize(268, 151)
        self.thumb.setAlignment(AF.AlignCenter)
        self.thumb.setStyleSheet("background: transparent; color: #555555; border: none;")
        tc_lay.addWidget(self.thumb)

        # Top badges overlay
        badge_row = QHBoxLayout()
        badge_row.setContentsMargins(8, 8, 8, 0)
        badge_row.setSpacing(4)
        
        b_live = QLabel("⬇ CLOUD")
        b_live.setStyleSheet("background: rgba(14,14,19,0.85); color:#a277ff; border-radius: 10px; padding: 2px 8px; font-family: 'JetBrains Mono',monospace; font-size:10px; font-weight:bold;")
        badge_row.addWidget(b_live)
        badge_row.addStretch()

        overlay = QWidget(thumb_container)
        overlay.setGeometry(0, 0, 268, 151)
        overlay.setStyleSheet("background: transparent;")
        overlay.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        overlay_lay = QVBoxLayout(overlay)
        overlay_lay.setContentsMargins(0, 0, 0, 0)
        overlay_lay.addLayout(badge_row)
        overlay_lay.addStretch()

        outer.addWidget(thumb_container)

        # ── Metadata strip ────────────────────────────────────────────────
        meta = QFrame()
        meta.setStyleSheet("background: rgba(27,27,32,0.9); border-radius: 0 0 12px 12px;")
        meta_lay = QVBoxLayout(meta)
        meta_lay.setContentsMargins(12, 10, 12, 10)
        meta_lay.setSpacing(6)

        name = title[:23] + "…" if len(title) > 23 else title
        t = QLabel(name.title())
        t.setObjectName("CardTitle")
        
        title_row = QHBoxLayout()
        title_row.addWidget(t)
        title_row.addStretch()
        meta_lay.addLayout(title_row)

        btn_row = QHBoxLayout()
        btn_row.setSpacing(6)
        
        if self.live_url:
            dl_live = QPushButton("🎥 Live")
            dl_live.setObjectName("ApplyBtn")
            dl_live.setFixedHeight(28)
            dl_live.setFocusPolicy(NoFocus)
            dl_live.setCursor(QCursor(HC))
            dl_live.clicked.connect(lambda: self.do_download(self.live_url))
            btn_row.addWidget(dl_live)
            
        if self.static_url:
            dl_static = QPushButton("🖼️ Static")
            dl_static.setObjectName("ApplyBtn")
            dl_static.setFixedHeight(28)
            dl_static.setFocusPolicy(NoFocus)
            dl_static.setCursor(QCursor(HC))
            dl_static.clicked.connect(lambda: self.do_download(self.static_url))
            btn_row.addWidget(dl_static)
            
        meta_lay.addLayout(btn_row)

        outer.addWidget(meta)

        threading.Thread(target=self._fetch_bytes, args=(thumb_url,), daemon=True).start()

    def _fetch_bytes(self, url):
        import urllib.request
        with OnlineCard._sem:
            try:
                req  = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"})
                data = urllib.request.urlopen(req, timeout=8).read()
                self._thumb_bytes.emit(data)
            except Exception:
                pass

    def _render_thumb(self, data: bytes):
        try:
            from PyQt6.QtGui import QPixmap
        except ImportError:
            from PyQt5.QtGui import QPixmap
        px = QPixmap()
        success = px.loadFromData(data)
        if not px.isNull():
            px = px.scaled(
                268, 151,
                Qt.AspectRatioMode.KeepAspectRatioByExpanding,
                Qt.TransformationMode.SmoothTransformation)
            px = apply_top_rounded_mask(px)
            self.thumb.setPixmap(px)
            self.thumb.setText("")

    def do_download(self, url):
        main_win = self.window()
        if hasattr(main_win, "start_download"):
            main_win.start_download(url)


class ExplorePanel(QWidget):
    catalog_ready = pyqtSignal(list)
    catalog_error = pyqtSignal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._all_items = []
        self._shown     = 0
        self._batch     = 24
        self._loading   = False

        lay = QVBoxLayout(self)
        lay.setContentsMargins(24, 24, 16, 16)
        lay.setSpacing(16)

        # Header (Provider & Search)
        header = QHBoxLayout()
        header.addWidget(section_title("explore"))
        header.addStretch()

        self.provider_cb = QComboBox()
        self.provider_cb.addItems(["MotionBgs", "MoeWalls", "Wallhaven (Images)"])
        self.provider_cb.setFixedHeight(32)
        self.provider_cb.setFixedWidth(160)
        
        self.res_cb = QComboBox()
        self.res_cb.addItems(["All Res", "1080p", "1440p", "4K"])
        self.res_cb.setFixedHeight(32)
        self.res_cb.setFixedWidth(100)
        
        cb_style = """
            QComboBox { 
                background: rgba(30,30,35,200); border: 1px solid #333333; 
                color: #cccccc; border-radius: 4px; padding: 4px 8px; font-weight: bold; 
            }
            QComboBox:on, QComboBox:focus {
                background: rgba(40,40,45,255);
                border: 1px solid #cba6f7;
            }
            QComboBox::drop-down { border: none; }
            QComboBox QAbstractItemView {
                background-color: #1e1e23;
                color: #cccccc;
                selection-background-color: #cba6f7;
                selection-color: #111111;
                border: 1px solid #333333;
                outline: none;
            }
        """
        self.provider_cb.setStyleSheet(cb_style)
        self.res_cb.setStyleSheet(cb_style)
        
        self.provider_cb.currentIndexChanged.connect(lambda: self.load_category(self.window().top_search_bar.text().strip()))
        self.res_cb.currentIndexChanged.connect(lambda: self.load_category(self.window().top_search_bar.text().strip()))
        
        header.addWidget(self.provider_cb)
        header.addWidget(self.res_cb)
        lay.addLayout(header)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        lay.addWidget(sep)

        # Category row
        cats_row = QHBoxLayout()
        cats_row.setSpacing(4)
        self.cat_btns = []
        
        from PyQt6.QtWidgets import QButtonGroup
        self.cat_group = QButtonGroup(self)
        self.cat_group.setExclusive(True)
        
        cats = [
            ("ALL",       ""),
            ("4K",        "4k"),
            ("ANIME",     "tag:anime"),
            ("GAMES",     "tag:games"),
            ("NATURE",    "tag:nature"),
            ("SUPERHERO", "tag:superhero"),
        ]
        for i, (label, tag) in enumerate(cats):
            b = QPushButton(label)
            b.setObjectName("TagPill")
            b.setFocusPolicy(NoFocus)
            b.setCheckable(True)
            b.setCursor(QCursor(HC))
            if tag == "": b.setChecked(True)
            b.clicked.connect(lambda _, t=tag: self.load_category(t))
            self.cat_group.addButton(b, i)
            self.cat_btns.append(b)
            cats_row.addWidget(b)
        cats_row.addStretch()
        lay.addLayout(cats_row)

        # Grid
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        
        self.scroll.setVerticalScrollBarPolicy(SBOff)
        self.scroll.setHorizontalScrollBarPolicy(SBOff)
        


        self.grid_w = QWidget()
        self.grid_w.setStyleSheet("background:transparent;")
        self.grid_lay = QGridLayout(self.grid_w)
        self.grid_lay.setSpacing(12)
        self.grid_lay.setAlignment(AF.AlignTop | AF.AlignLeft)
        self.scroll.setWidget(self.grid_w)
        lay.addWidget(self.scroll)

        # Footer
        bot = QHBoxLayout()
        self.status_lbl = QLabel("CONNECTING TO CATALOG…")
        self.status_lbl.setStyleSheet(
            "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px; letter-spacing:2px;")
        bot.addWidget(self.status_lbl)
        bot.addStretch()
        self.more_btn = accent_btn("+ LOAD MORE")
        self.more_btn.setVisible(False)
        self.more_btn.clicked.connect(self.show_next_batch)
        bot.addWidget(self.more_btn)
        lay.addLayout(bot)

        self.catalog_ready.connect(self._on_catalog_ready)
        self.catalog_error.connect(self._on_error)
        self.load_category("")

    def load_category(self, tag):
        if tag.startswith("http"):
            self.window().start_download(tag)
            return

        if tag.startswith("tag:") or tag == "":
            pass

        for btn in self.cat_btns:
            btn.setChecked(btn.text().lower() == (tag.replace("tag:", "") or "all"))
        self._all_items = []
        self._shown     = 0
        self.more_btn.setVisible(False)
        for i in reversed(range(self.grid_lay.count())):
            w = self.grid_lay.itemAt(i).widget()
            if w: w.setParent(None)
        if self._loading: return
        self._loading = True
        self.status_lbl.setText("⏳  LOADING CATALOG…")
        
        provider = self.provider_cb.currentText()
        res_idx = self.res_cb.currentIndex()
        threading.Thread(target=self._scrape, args=(provider, tag, res_idx), daemon=True).start()

    def show_next_batch(self):
        batch = self._all_items[self._shown : self._shown + self._batch]
        for i, (_, title, thumb_url, live_url, static_url) in enumerate(batch):
            card = OnlineCard(title, thumb_url, live_url, static_url)
            idx  = self._shown + i
            self.grid_lay.addWidget(card, idx // 3, idx % 3)
        self._shown += len(batch)
        self.status_lbl.setText(
            f"✓  {self._shown} / {len(self._all_items)} LOADED")
        self.more_btn.setVisible(self._shown < len(self._all_items))

    def _scrape(self, provider, tag, res_idx=0):
        import urllib.request, re, urllib.parse
        try:
            items = []
            seen = set()
            headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}
            
            res_str = ""
            if res_idx == 1: res_str = "1080p"
            elif res_idx == 2: res_str = "1440p"
            elif res_idx == 3: res_str = "4k"
            
            if provider == "MotionBgs":
                base = "https://motionbgs.com"
                query = tag.replace("tag:", "") if tag else ""
                if res_str: query = f"{query} {res_str}".strip()
                
                if query:
                    path = f"/search?q={urllib.parse.quote(query)}"
                else:
                    path = "/"
                    
                req  = urllib.request.Request(base + path, headers=headers)
                html = urllib.request.urlopen(req, timeout=12).read().decode("utf-8", errors="replace")
                matches = re.findall(r'media/(\d+)/([^>"\']+?)\.jpg', html)
                
                for mid, raw_name in matches:
                    if mid not in seen:
                        seen.add(mid)
                        clean = re.sub(r'\.\d+x\d+$', '', raw_name)
                        title = clean.replace("-", " ").replace(".", " ").title()
                        items.append((
                            mid, title,
                            f"{base}/i/c/364x205/media/{mid}/{raw_name}.jpg",
                            f"{base}/dl/hd/{mid}/",
                            f"{base}/media/{mid}/{raw_name}.jpg"
                        ))
                        
            elif provider == "MoeWalls":
                base = "https://moewalls.com"
                query = tag.replace("tag:", "") if tag else ""
                if res_str: query = f"{query} {res_str}".strip()
                
                if not query:
                    base_path = "/"
                else:
                    base_path = f"/?s={urllib.parse.quote(query)}"
                
                for p in range(1, 5):
                    if p == 1:
                        path = base_path
                    else:
                        if base_path.startswith("/?"):
                            path = f"/page/{p}{base_path}"
                        else:
                            path = f"/page/{p}/"
                    
                    try:
                        req  = urllib.request.Request(base + path, headers=headers)
                        html = urllib.request.urlopen(req, timeout=8).read().decode("utf-8", errors="replace")
                        matches = re.findall(r'<a title="([^"]+)".*?<img[^>]+src="([^"]+wp-content/uploads/([0-9]{4})/[^"]+-thumb[^"]*\.jpg)"', html)
                        
                        if not matches:
                            break
                            
                        for title, thumb_url, year in matches:
                            if thumb_url not in seen:
                                seen.add(thumb_url)
                                clean_title = title.replace("Live Wallpaper", "").replace("-", "").strip()
                                slug_match = re.search(r'/([^/]+)-thumb', thumb_url)
                                if slug_match:
                                    slug = slug_match.group(1)
                                    dl_url = f"{base}/wp-content/uploads/preview/{year}/{slug}-preview.webm"
                                    static_url = thumb_url.replace("-364x205", "").replace("-314x177", "")
                                    items.append((slug, clean_title, thumb_url, dl_url, static_url))
                    except Exception:
                        break

            elif provider.startswith("Wallhaven"):
                base = "https://wallhaven.cc/api/v1/search"
                import json
                
                res_idx = self.res_cb.currentIndex()
                res_map = {0: "", 1: "1920x1080", 2: "2560x1440", 3: "3840x2160"}
                res = res_map.get(res_idx, "")
                
                query = tag.replace("tag:", "")
                params = [("q", query)]
                if res:
                    params.append(("resolutions", res))
                params.append(("sorting", "random"))
                
                for p in range(1, 3):
                    url = base + "?" + urllib.parse.urlencode(params + [("page", str(p))])
                    req = urllib.request.Request(url, headers=headers)
                    try:
                        resp = urllib.request.urlopen(req, timeout=10).read().decode("utf-8")
                        data = json.loads(resp)
                        for d in data.get("data", []):
                            thumb = d.get("thumbs", {}).get("small", "")
                            dl = d.get("path", "")
                            res_str = d.get("resolution", "")
                            if dl not in seen:
                                seen.add(dl)
                                items.append((d.get("id", ""), res_str, thumb, None, dl))
                    except Exception:
                        break

            self.catalog_ready.emit(items)
        except Exception as ex:
            self.catalog_error.emit(str(ex))

    def _on_catalog_ready(self, items):
        self._loading   = False
        self._all_items = items
        self._shown     = 0
        self.show_next_batch()

    def _on_error(self, msg):
        self._loading = False
        self.status_lbl.setText(f"✗  {msg[:60]}")
        self.status_lbl.setStyleSheet(
            "color:#f38ba8; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")


class DisplaysPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(24)

        layout.addWidget(section_title("displays"))
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)

        monitors = self._get_monitors()
        for mon in monitors:
            layout.addWidget(self._make_monitor_card(mon))
        layout.addStretch()

    def _get_monitors(self):
        out = subprocess.check_output("xrandr --query", shell=True, text=True)
        monitors = []
        for line in out.split('\n'):
            m = re.match(r'^(\S+) connected.*?(\d+x\d+)\+', line)
            if m:
                monitors.append({"name": m.group(1), "res": m.group(2)})
        return monitors

    def _make_monitor_card(self, mon):
        card = QFrame()
        card.setObjectName("MonitorCard")
        card.setFixedHeight(160)
        lay = QVBoxLayout(card)
        lay.setContentsMargins(20, 16, 20, 16)
        lay.setSpacing(12)

        header = QHBoxLayout()
        name_lbl = QLabel(mon['name'].upper())
        name_lbl.setStyleSheet(
            "color:#cccccc; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:13px; font-weight:bold; letter-spacing:2px;")
        res_lbl = QLabel(mon['res'])
        res_lbl.setStyleSheet(
            "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:11px;")
        header.addWidget(name_lbl)
        header.addStretch()
        header.addWidget(res_lbl)
        lay.addLayout(header)

        scale_row = QHBoxLayout()
        scale_row.setSpacing(6)
        group = QButtonGroup(card)
        safe_mon = mon['name'].replace('-', '_')
        current_mode = conf_get(f"SCALE_{safe_mon}", "FILL").upper()

        for mode in ["FIT", "FILL", "STRETCH", "CENTER"]:
            btn = QPushButton(mode)
            btn.setObjectName("ScaleBtn")
            btn.setFocusPolicy(NoFocus)
            btn.setCheckable(True)
            btn.setCursor(QCursor(HC))
            if mode == current_mode:
                btn.setChecked(True)
            group.addButton(btn)
            btn.clicked.connect(lambda _, m=mode, n=mon['name']: self.set_scale(n, m))
            scale_row.addWidget(btn)
        scale_row.addStretch()
        lay.addLayout(scale_row)
        return card

    def set_scale(self, monitor, mode):
        safe_mon = monitor.replace("-", "_")
        conf_set(f"SCALE_{safe_mon}", mode.upper())
        threading.Thread(
            target=lambda: subprocess.run(f"pkill -f 'aura-wallpaper-{monitor}'", shell=True),
            daemon=True).start()


class SettingsPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(0, 0, 0, 0)
        
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame if hasattr(QFrame, 'Shape') else QFrame.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        
        content = QWidget()
        content.setStyleSheet("background: transparent;")
        
        layout = QVBoxLayout(content)
        layout.setContentsMargins(24, 24, 24, 24)
        layout.setSpacing(12)
        
        scroll.setWidget(content)
        main_layout.addWidget(scroll)

        layout.addWidget(section_title("settings"))
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine if hasattr(QFrame, 'Shape') else QFrame.HLine)
        sep.setStyleSheet("color: #1a1a1a;")
        layout.addWidget(sep)
        layout.addSpacing(8)

        opts = [
            ("AUTOSTART",        "Start animated WelsPaper engine on boot", "AUTOSTART",    "1"),
            ("AUTO-THEMING",     "Sync accent color from WelsPaper", "THEME",        "1"),
            ("DYNAMIC BACKGROUND","Tint app background with accent (disable on low-end PCs)", "DYNAMIC_BG", "1"),
            ("AUTO PAUSE",       "Pause on fullscreen windows",       "AUTO_PAUSE",   "1"),
            ("BATTERY SAVER",    "Pause below battery threshold",     "BATTERY_PAUSE","1"),
            ("START PAUSED",     "Begin session paused",              "START_PAUSED", "0"),
        ]

        # Sync AUTOSTART key with actual bspwm config before rendering
        cfg = os.path.expanduser(f"~/.config/bspwm/rices/{get_current_rice()}/theme-config.bash")
        if os.path.exists(cfg):
            with open(cfg, "r") as f:
                if 'ENGINE="Aura"' in f.read():
                    conf_set("AUTOSTART", "1")
                else:
                    conf_set("AUTOSTART", "0")

        for label, desc, key, default in opts:
            val = conf_get(key, default)
            layout.addWidget(self._make_row(label, desc, key, val == "1"))
        layout.addWidget(self._make_kitty_row())

        layout.addSpacing(16)
        
        # Brightness Slider
        bri_row = QFrame()
        bri_row.setObjectName("SettingRow")
        bri_row.setFixedHeight(64)
        h = QHBoxLayout(bri_row)
        h.setContentsMargins(16, 0, 16, 0)
        
        texts = QVBoxLayout()
        lbl = QLabel("DIM / BRIGHTNESS")
        lbl.setStyleSheet("color:#e4e1e9; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:12px; font-weight:bold; letter-spacing:1px;")
        desc_lbl = QLabel("Adjust WelsPaper brightness (live)")
        desc_lbl.setStyleSheet("color:#a0a0a0; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        texts.addWidget(lbl)
        texts.addWidget(desc_lbl)
        h.addLayout(texts)
        h.addStretch()
        
        self.bri_slider = QSlider(Qt.Orientation.Horizontal if hasattr(Qt, 'Orientation') else Qt.Horizontal)
        self.bri_slider.setFixedSize(120, 20)
        self.bri_slider.setFocusPolicy(NoFocus)
        self.bri_slider.setRange(-100, 100)
        self.bri_slider.setValue(int(conf_get("BRIGHTNESS", "0")))
        
        def _on_bri_change(v):
            conf_set("BRIGHTNESS", str(v))
            main_win = self.window()
            if hasattr(main_win, "_send_ipc"):
                main_win._send_ipc("brightness", v)
                
        self.bri_slider.valueChanged.connect(_on_bri_change)
        h.addWidget(self.bri_slider)
        
        layout.addWidget(bri_row)

        layout.addSpacing(20)
        layout.addWidget(section_title("intervals"))
        layout.addSpacing(8)

        iv_row = QHBoxLayout()
        iv_row.addWidget(mono_lbl("THEMING INTERVAL (sec)", "#a0a0a0", 11, 1))
        iv_row.addStretch()
        self.interval_input = QLineEdit(conf_get("THEME_INTERVAL", "15"))
        self.interval_input.setFixedWidth(60)
        self.interval_input.setFixedHeight(28)
        iv_row.addWidget(self.interval_input)
        save_iv = accent_btn("SAVE")
        save_iv.setFixedHeight(28)
        save_iv.clicked.connect(
            lambda: conf_set("THEME_INTERVAL", self.interval_input.text().strip()))
        iv_row.addSpacing(8)
        iv_row.addWidget(save_iv)
        layout.addLayout(iv_row)

        layout.addSpacing(8)
        bat_row = QHBoxLayout()
        bat_row.addWidget(mono_lbl("BATTERY PAUSE BELOW (%)", "#a0a0a0", 11, 1))
        bat_row.addStretch()
        self.bat_input = QLineEdit(conf_get("BATTERY_PAUSE_BELOW", "60"))
        self.bat_input.setFixedWidth(60)
        self.bat_input.setFixedHeight(28)
        bat_row.addWidget(self.bat_input)
        save_bat = accent_btn("SAVE")
        save_bat.setFixedHeight(28)
        save_bat.clicked.connect(
            lambda: conf_set("BATTERY_PAUSE_BELOW", self.bat_input.text().strip()))
        bat_row.addWidget(save_bat)
        layout.addLayout(bat_row)
        
        layout.addSpacing(8)
        slide_row = QHBoxLayout()
        slide_row.addWidget(mono_lbl("AUTO ROTATE (min, 0=off)", "#a0a0a0", 11, 1))
        slide_row.addStretch()
        self.slide_input = QLineEdit(conf_get("SLIDESHOW", "0"))
        self.slide_input.setFixedWidth(60)
        self.slide_input.setFixedHeight(28)
        slide_row.addWidget(self.slide_input)
        save_slide = accent_btn("SAVE")
        save_slide.setFixedHeight(28)
        save_slide.clicked.connect(
            lambda: conf_set("SLIDESHOW", self.slide_input.text().strip()))
        slide_row.addSpacing(8)
        slide_row.addWidget(save_slide)
        layout.addLayout(slide_row)

        
        layout.addStretch()

    def _make_kitty_row(self):
        row = QFrame()
        row.setObjectName("SettingRow")
        row.setFixedHeight(64)
        h = QHBoxLayout(row)
        h.setContentsMargins(16, 0, 16, 0)

        texts = QVBoxLayout()
        lbl = QLabel("THEME TERMINALS")
        lbl.setStyleSheet(
            "color:#e4e1e9; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:12px; font-weight:bold; letter-spacing:1px;")
        desc_lbl = QLabel("Propagate accent colors to Kitty and Ghostty")
        desc_lbl.setStyleSheet(
            "color:#a0a0a0; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        texts.addWidget(lbl)
        texts.addWidget(desc_lbl)
        h.addLayout(texts)
        h.addStretch()

        sw = ToggleSwitch()
        targets = conf_get("THEME_TARGETS", "ghostzk bspwm polybar rofi dunst kitty ghostty mpv")
        sw._on = "kitty" in targets or "ghostty" in targets
        sw.update()

        def _toggle(val):
            targets_raw = conf_get("THEME_TARGETS", "ghostzk bspwm polybar rofi dunst kitty ghostty mpv")
            targets_clean = targets_raw.replace('"', '').replace("'", "")
            parts = [p for p in targets_clean.split() if p not in ("kitty", "ghostty")]
            if val:
                parts.extend(["kitty", "ghostty"])
            conf_set("THEME_TARGETS", f'"{ " ".join(parts) }"')

        sw.toggled.connect(_toggle)
        h.addWidget(sw)
        return row

    def _make_row(self, label, desc, key, initial):
        row = QFrame()
        row.setObjectName("SettingRow")
        row.setFixedHeight(64)
        h = QHBoxLayout(row)
        h.setContentsMargins(16, 0, 16, 0)

        texts = QVBoxLayout()
        lbl = QLabel(label)
        lbl.setStyleSheet(
            "color:#e4e1e9; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:12px; font-weight:bold; letter-spacing:1px;")
        desc_lbl = QLabel(desc)
        desc_lbl.setWordWrap(True)
        desc_lbl.setStyleSheet(
            "color:#a0a0a0; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:10px;")
        texts.addWidget(lbl)
        texts.addWidget(desc_lbl)
        h.addLayout(texts)
        h.addStretch()

        toggle = ToggleSwitch(initial=initial)
        def on_toggle(val, k=key):
            conf_set(k, "1" if val else "0")
            if k == "AUTOSTART":
                # Directly update gh0stzk's bspwm config to set the engine
                cfg = os.path.expanduser(f"~/.config/bspwm/rices/{get_current_rice()}/theme-config.bash")
                if os.path.exists(cfg):
                    engine_val = "Aura" if val else "Theme"
                    subprocess.run(["sed", "-i", f's/^ENGINE=.*/ENGINE="{engine_val}"/', cfg])
        toggle.toggled.connect(on_toggle)
        h.addWidget(toggle)
        return row


class AboutPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(40, 40, 40, 40)
        layout.setSpacing(24)

        logo = QLabel("AURA")
        logo.setStyleSheet(
            "color:#ffffff; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:48px; font-weight:bold; letter-spacing:16px;")
        logo.setAlignment(AF.AlignCenter)
        layout.addWidget(logo)

        sub = QLabel("ANIMATED LIVE WELSPAPER ENGINE · X11 · BSPWM")
        sub.setStyleSheet(
            "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace;"
            "font-size:11px; letter-spacing:3px;")
        sub.setAlignment(AF.AlignCenter)
        layout.addWidget(sub)

        layout.addSpacing(12)

        info_box = QFrame()
        info_box.setObjectName("SettingRow")
        info_box.setStyleSheet("#SettingRow { border-radius: 4px; border: 1px solid #1a1a1a; background: #111111; }")
        ib_lay = QVBoxLayout(info_box)
        ib_lay.setContentsMargins(24, 20, 24, 20)
        for line in [
            "xwinwrap embeds mpv directly into the X11 root window.",
            "Dominant color extracted per-WelsPaper, propagated to bspwm,",
            "Polybar, Rofi, Dunst, Kitty and Ghostty automatically.",
            "",
            "Built for gh0stzk dotfiles.",
        ]:
            l = QLabel(line)
            l.setStyleSheet(
                "color:#888888; font-family:'JetBrains Mono','Fira Mono',monospace; font-size:11px;")
            ib_lay.addWidget(l)
        layout.addWidget(info_box)

        layout.addSpacing(16)
        deps = ["xwinwrap", "mpv", "ffmpeg", "ImageMagick", "python-colorthief"]
        dep_row = QHBoxLayout()
        dep_row.setSpacing(8)
        for dep in deps:
            ok = subprocess.run(f"command -v {dep.split('-')[-1]}", shell=True,
                                capture_output=True).returncode == 0
            pill = QLabel(f"{'✓' if ok else '✗'}  {dep.upper()}")
            pill.setStyleSheet(
                f"color:{'#a6e3a1' if ok else '#f38ba8'};"
                f"font-family:'JetBrains Mono','Fira Mono',monospace;"
                f"font-size:10px; font-weight:bold; letter-spacing:1px;"
                f"background:#111111; border:1px solid {'#1a3a1a' if ok else '#3a1a1a'};"
                f"border-radius:3px; padding: 4px 10px;")
            dep_row.addWidget(pill)
        dep_row.addStretch()
        layout.addLayout(dep_row)
        layout.addStretch()


